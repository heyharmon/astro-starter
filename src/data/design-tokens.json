{
  "meta": {
    "version": "2.0",
    "description": "Machine-readable design system for the Mold Catchers site, extracted from moldcatchers.com (Avada theme). CSS source of truth is src/styles/global.css.",
    "reference": "https://moldcatchers.com/"
  },
  "colors": {
    "background": {
      "primary": "white",
      "secondary": "cream (#fbf7f3)",
      "tertiary": "surface (#f2f3f5)",
      "dark": "teal-800 (#004c4c)",
      "card": "white"
    },
    "text": {
      "primary": "teal-800 (#004c4c)",
      "body": "teal-800/90",
      "muted": "slate (#4a4e57)",
      "onDark": "white",
      "accent": "copper (#a66d3f)"
    },
    "border": {
      "default": "neutral-200 (#e2e2e2)",
      "card": "neutral-200",
      "input": "neutral-300",
      "focus": "teal-500"
    },
    "accent": {
      "base": "teal-800 (#004c4c)",
      "hover": "teal-500 (#008787)",
      "buttonHover": "teal-700 (#006352)",
      "warm": "copper (#a66d3f)"
    },
    "button": {
      "primary": { "bg": "teal-800", "text": "white", "hoverBg": "teal-700" },
      "ghost": { "bg": "transparent", "text": "teal-800", "border": "teal-800", "hoverBg": "teal-800", "hoverText": "white" },
      "inverse": { "bg": "white", "text": "teal-800", "hoverBg": "cream", "note": "use on teal-800 backgrounds" }
    }
  },
  "typography": {
    "fonts": {
      "heading": "Manrope",
      "body": "Manrope",
      "mono": "JetBrains Mono"
    },
    "headings": {
      "h1": { "classes": "font-semibold tracking-tight text-teal-800 text-4xl sm:text-6xl", "lineHeight": "1.2", "referenceSize": "64px" },
      "h2": { "classes": "font-semibold tracking-tight text-teal-800 text-3xl sm:text-5xl", "lineHeight": "1.2", "referenceSize": "52px" },
      "h3": { "classes": "font-semibold text-teal-800 text-xl sm:text-2xl", "lineHeight": "1.3", "referenceSize": "28px" }
    },
    "body": { "classes": "text-teal-800/90", "size": "17px", "lineHeight": "1.9", "note": "reference uses 19px/2.0 — slightly tightened for web ergonomics" },
    "eyebrow": { "classes": "text-sm uppercase tracking-[3px] text-copper", "note": "reference typography2: 15px, letter-spacing 3px" }
  },
  "spacing": {
    "sectionPadding": "py-20 sm:py-28",
    "containerMax": "max-w-6xl",
    "containerPx": "px-6",
    "gridGap": "gap-8",
    "cardPadding": "p-8"
  },
  "effects": {
    "borderRadius": {
      "card": "rounded-xl",
      "button": "rounded-[5px]",
      "input": "rounded-[5px]",
      "image": "rounded-xl"
    },
    "shadows": { "subtle": "shadow-sm", "note": "Reference site is flat — prefer borders and background shifts" }
  },
  "componentPatterns": {
    "hero-split": {
      "description": "Hero with large teal headline + body on the left, photo on the right. Cream or white background. Primary CTA button.",
      "reference": "moldcatchers.com homepage hero"
    },
    "reasons-grid": {
      "description": "Grid of reasons/feature cards (Health Symptoms, Visible Mold Growth, Musty Odors, Water Damage) — title + short copy.",
      "reference": "homepage 'Do you need mold testing?' section"
    },
    "steps-3": {
      "description": "Numbered three-step process: Schedule → Test → Get results.",
      "reference": "homepage 'How it works'"
    },
    "cta-banner": {
      "description": "Full-width teal-800 band with white heading 'Defeat mold. Get a free estimate.' and inverse button. Appears above the footer on every page.",
      "reference": "site-wide pre-footer CTA"
    },
    "footer-dark": {
      "description": "teal-800 footer, white text: logo, email, phone, copyright line.",
      "reference": "site-wide footer"
    }
  }
}
