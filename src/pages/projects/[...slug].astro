---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image?.src}
>
  <article class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
    <header>
      <p class="font-mono text-xs text-neutral-400">
        src/content/projects/{project.id}.md
      </p>
      <h1 class="mt-4">{project.data.title}</h1>
      <p class="mt-4 text-lg text-neutral-500">{project.data.description}</p>
      <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-neutral-200 pt-8 text-sm sm:grid-cols-4">
        {project.data.client && (
          <div>
            <dt class="text-neutral-500">Client</dt>
            <dd class="mt-1">{project.data.client}</dd>
          </div>
        )}
        {project.data.location && (
          <div>
            <dt class="text-neutral-500">Location</dt>
            <dd class="mt-1">{project.data.location}</dd>
          </div>
        )}
        <div>
          <dt class="text-neutral-500">Order</dt>
          <dd class="mt-1 font-mono">{project.data.order}</dd>
        </div>
        <div>
          <dt class="text-neutral-500">Featured</dt>
          <dd class="mt-1 font-mono">{project.data.featured ? "true" : "false"}</dd>
        </div>
      </dl>
      {project.data.image && (
        <div class="mt-10 aspect-video overflow-hidden rounded-xl bg-neutral-200">
          <img
            src={project.data.image.src}
            alt={project.data.image.alt}
            class="h-full w-full object-cover"
          />
        </div>
      )}
    </header>

    <div class="prose mt-12">
      <Content />
    </div>

    <footer class="mt-16 border-t border-neutral-200 pt-8">
      <a href="/projects" class="text-sm underline">← Back to all projects</a>
    </footer>
  </article>
</BaseLayout>
