---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Selected work and case studies.">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <h1>Projects</h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-500">
      Selected work and case studies.
    </p>
  </section>

  <!-- Project list -->
  <section class="border-t border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
      {projects.length === 0 ? (
        <p class="text-neutral-500">No projects yet.</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="block overflow-hidden rounded-xl border border-neutral-200 bg-white transition hover:border-neutral-400"
            >
              {project.data.image && (
                <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
                  <img
                    src={project.data.image.src}
                    alt={project.data.image.alt}
                    class="h-full w-full object-cover"
                  />
                </div>
              )}
              <div class="p-8">
                <h3>{project.data.title}</h3>
                <p class="mt-2 text-sm text-neutral-500">
                  {project.data.description}
                </p>
                {project.data.client && (
                  <p class="mt-4 text-xs uppercase tracking-wide text-neutral-500">
                    {project.data.client}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
