---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Demonstrates a second content collection — non-chronological, manually ordered, with a featured flag.">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="text-sm uppercase tracking-wide text-neutral-500">
      Tier 3 / 3 — Content collection (manually ordered)
    </p>
    <h1 class="mt-4">Projects collection</h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-500">
      A second collection with a different schema than <a href="/blog" class="underline">posts</a>. No <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">date</code> field —
      sorting uses a manual <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">order</code> integer. A <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">featured</code> boolean lets you surface specific entries elsewhere
      (homepages, marketing pages) without filtering by date.
    </p>
  </section>

  <!-- Project list -->
  <section class="border-t border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
      {projects.length === 0 ? (
        <p class="text-neutral-500">No projects yet. Add a Markdown file to <code>src/content/projects/</code>.</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="block overflow-hidden rounded-xl border border-neutral-200 bg-white transition hover:border-neutral-400"
            >
              {project.data.image && (
                <div class="aspect-4/3 overflow-hidden bg-neutral-200">
                  <img
                    src={project.data.image.src}
                    alt={project.data.image.alt}
                    class="h-full w-full object-cover"
                  />
                </div>
              )}
              <div class="p-8">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs text-neutral-400">order: {project.data.order}</span>
                  {project.data.featured && (
                    <span class="rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700">featured</span>
                  )}
                </div>
                <h3 class="mt-2">{project.data.title}</h3>
                <p class="mt-2 text-sm text-neutral-500">
                  {project.data.description}
                </p>
                <p class="mt-6 font-mono text-xs text-neutral-400">
                  src/content/projects/{project.id}.md
                </p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
