---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("projects")).filter((p) => !p.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const p = entry.data;
const hero = p.heroImage ?? p.image;

const meta = [
  p.jobType ? { label: "Job Type", value: p.jobType } : null,
  p.location ? { label: "Location", value: p.location } : null,
  p.client ? { label: "Client", value: p.client } : null,
].filter(Boolean);

// Weave the gallery through the narrative: each section's heading + copy comes
// FIRST, followed by its own cluster of photos, so the page reads
// text → images → text → images … (matching the source site's project pages).
// Photos are distributed evenly, one cluster per section.
function splitInto(arr, k) {
  if (k <= 0) return [arr];
  const res = [];
  const base = Math.floor(arr.length / k);
  let rem = arr.length % k;
  let idx = 0;
  for (let i = 0; i < k; i++) {
    const size = base + (rem > 0 ? 1 : 0);
    if (rem > 0) rem--;
    res.push(arr.slice(idx, idx + size));
    idx += size;
  }
  return res;
}

// If any section carries its own `images`, sections own their photos directly
// (uneven groups, matching the source). Otherwise fall back to splitting the
// flat `gallery` evenly, one cluster per section.
const sectionsOwnImages = p.sections.some((s) => s.images?.length);

const story = [];
if (p.sections.length > 0) {
  const chunks = sectionsOwnImages ? null : splitInto(p.gallery, p.sections.length);
  p.sections.forEach((section, i) => {
    story.push({ type: "text", section });
    if (section.video) story.push({ type: "video", video: section.video });
    const imgs = section.images?.length ? section.images : chunks?.[i];
    if (imgs?.length) story.push({ type: "images", images: imgs, group: i });
  });
} else if (p.gallery.length > 0) {
  story.push({ type: "images", images: p.gallery, group: 0 });
}

const hasGallery = story.some((b) => b.type === "images");
---

<BaseLayout title={p.title} description={p.description} image={p.heroImage?.src ?? p.image?.src}>
  <!-- ===================== HERO ===================== -->
  <section class="relative flex min-h-[62vh] flex-col items-center justify-center overflow-hidden bg-black px-6 pt-28 pb-16 text-center lg:min-h-[68vh]">
    {
      hero && (
        <img
          src={hero.src}
          alt={hero.alt}
          class="absolute inset-0 h-full w-full object-cover"
        />
      )
    }
    <div
      class="absolute inset-0"
      style="background-image:linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.78) 100%);"
    >
    </div>
    <div class="relative">
      <p class="eyebrow eyebrow--center">Project</p>
      <h1 class="mt-5 text-[3rem] leading-[1.02] sm:text-[4.5rem] lg:text-[5.5rem]">{p.title}</h1>
      {
        p.subtitle && (
          <p class="mt-5 text-[15px] font-medium tracking-[2px] text-ink uppercase">{p.subtitle}</p>
        )
      }
      {
        hasGallery && (
          <div class="mt-9 flex justify-center">
            <a href="#work" class="btn-outline">See the work</a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ===================== ABOUT THE PROJECT ===================== -->
  <section class="bg-surface py-20 lg:py-28">
    <div class="epw-container grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">About the project</p>
        {p.intro && <p class="mt-6 max-w-xl text-[18px] leading-relaxed text-white">{p.intro}</p>}
        {
          p.scope.length > 0 && (
            <ul class="mt-8 space-y-3">
              {p.scope.map((item) => (
                <li class="flex gap-3 text-[16px] leading-relaxed text-ink">
                  <span class="mt-[10px] h-[6px] w-[6px] flex-none bg-white/70" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        meta.length > 0 && (
          <dl class="space-y-8 lg:border-l lg:border-line lg:pl-12">
            {meta.map((m) => (
              <div>
                <dt class="text-[13px] font-semibold tracking-[1.5px] text-ink-dim uppercase">{m.label}</dt>
                <dd class="mt-2 font-display text-[2rem] leading-none text-white">{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- ===================== STORY: TEXT WOVEN THROUGH GALLERY ===================== -->
  {
    story.length > 0 && (
      <section id="work" class="bg-black py-20 scroll-mt-24 lg:py-28">
        <div class="epw-container space-y-16 lg:space-y-24">
          {story.map((block) =>
            block.type === "text" ? (
              <div class="mx-auto max-w-3xl">
                <h2 class="heading-rule max-w-2xl">{block.section.heading}</h2>
                <div class="mt-5 space-y-5 text-[17px] leading-relaxed text-ink">
                  {block.section.body
                    .split(/\n\n+/)
                    .map((par) => par.trim())
                    .filter(Boolean)
                    .map((par) => <p>{par}</p>)}
                </div>
              </div>
            ) : block.type === "video" ? (
              <div class="overflow-hidden border border-white/10 bg-surface">
                <video
                  src={block.video.src}
                  poster={block.video.poster}
                  class="h-auto w-full object-cover"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              </div>
            ) : (
              <div
                class="grid gap-4"
                style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));"
              >
                {block.images.map((g) => (
                  <button
                    type="button"
                    class="epw-lightbox-trigger group block cursor-zoom-in overflow-hidden border border-white/10 bg-surface"
                    data-src={g.src}
                    data-alt={g.alt}
                    data-group={block.group}
                    aria-label={`Enlarge photo: ${g.alt}`}
                  >
                    <img
                      src={g.src}
                      alt={g.alt}
                      loading="lazy"
                      class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] lg:h-80"
                    />
                  </button>
                ))}
              </div>
            ),
          )}
        </div>
      </section>
    )
  }

  <!-- ===================== CTA ===================== -->
  <section class="relative overflow-hidden bg-black">
    <img
      src="/images/eaglepoint/cta-bg.jpg"
      alt="Welding tools and equipment"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0"
      style="background-image:linear-gradient(to bottom, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.72) 100%);"
    >
    </div>
    <div class="relative epw-container py-24 text-center lg:py-28">
      <p class="eyebrow eyebrow--center">Get in touch</p>
      <h2 class="mt-5">Have a project in mind?</h2>
      <p class="mx-auto mt-5 max-w-xl text-[17px] leading-relaxed text-ink">
        From structural steel to custom architectural metalwork, our certified team is ready to
        deliver, on spec and on time.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-outline">Get a quote</a>
        <a href="/projects" class="btn-outline-sm">All projects</a>
      </div>
    </div>
  </section>

  <!-- ===================== LIGHTBOX ===================== -->
  {
    hasGallery && (
      <div
        id="epw-lightbox"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/92 p-4 sm:p-8"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-label="Photo viewer"
      >
        <button
          type="button"
          data-lb-close
          class="absolute top-4 right-5 text-4xl leading-none text-white/70 transition-colors hover:text-white"
          aria-label="Close"
        >
          &times;
        </button>
        <button
          type="button"
          data-lb-prev
          class="absolute left-3 text-5xl leading-none text-white/60 transition-colors hover:text-white sm:left-8"
          aria-label="Previous photo"
        >
          &#8249;
        </button>
        <img
          data-lb-img
          src=""
          alt=""
          class="max-h-[88vh] max-w-[92vw] object-contain shadow-2xl"
        />
        <button
          type="button"
          data-lb-next
          class="absolute right-3 text-5xl leading-none text-white/60 transition-colors hover:text-white sm:right-8"
          aria-label="Next photo"
        >
          &#8250;
        </button>
      </div>
    )
  }
</BaseLayout>

<script>
  const lb = document.getElementById("epw-lightbox");
  if (lb) {
    const imgEl = lb.querySelector("[data-lb-img]");
    const triggers = Array.from(document.querySelectorAll(".epw-lightbox-trigger"));

    // Group photos so prev/next cycles within the same photo set.
    const groups = {};
    triggers.forEach((t) => {
      const g = t.dataset.group ?? "0";
      (groups[g] ||= []).push(t);
    });

    let current = [];
    let index = 0;

    const show = () => {
      const t = current[index];
      if (!t) return;
      imgEl.setAttribute("src", t.dataset.src);
      imgEl.setAttribute("alt", t.dataset.alt || "");
    };

    const open = (t) => {
      const g = t.dataset.group ?? "0";
      current = groups[g];
      index = current.indexOf(t);
      show();
      lb.classList.remove("hidden");
      lb.classList.add("flex");
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      lb.classList.add("hidden");
      lb.classList.remove("flex");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    const step = (dir) => {
      if (!current.length) return;
      index = (index + dir + current.length) % current.length;
      show();
    };

    triggers.forEach((t) => t.addEventListener("click", () => open(t)));
    lb.querySelector("[data-lb-close]").addEventListener("click", close);
    lb.querySelector("[data-lb-prev]").addEventListener("click", () => step(-1));
    lb.querySelector("[data-lb-next]").addEventListener("click", () => step(1));
    lb.addEventListener("click", (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener("keydown", (e) => {
      if (lb.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });
  }
</script>
