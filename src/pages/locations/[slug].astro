---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteMeta from "../../data/site-meta.json";

export async function getStaticPaths() {
  const locations = await getCollection("locations", ({ data }) => !data.draft);
  return locations.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasBody = entry.body?.trim().length > 0;
---

<BaseLayout title={data.title} description={data.description} image={data.heroImage?.src}>
  <!-- Hero: split panel + photo -->
  <section class="grid lg:grid-cols-2">
    <div class="order-2 flex items-center bg-ice lg:order-1">
      <div class="w-full px-6 py-20 sm:px-12 sm:py-28 lg:pl-[max(1.5rem,calc((100vw-72rem)/2))] lg:pr-16">
        <h1 class="text-4xl sm:text-6xl">{data.headline}</h1>
        {data.subheadline && <p class="mt-6 max-w-md text-lg">{data.subheadline}</p>}
        {data.bullets.length > 0 && (
          <ul class="mt-6 max-w-md list-disc space-y-1 pl-6">
            {data.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        )}
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a href="/request-free-estimate" class="btn-primary">Free Estimate</a>
          <a href={siteMeta.contact.phoneHref} class="text-sm font-semibold">
            Call us {siteMeta.contact.phone}
          </a>
        </div>
      </div>
    </div>
    <div class="order-1 min-h-[320px] lg:order-2 lg:min-h-[560px]">
      {data.heroImage && (
        <img src={data.heroImage.src} alt={data.heroImage.alt} class="h-full w-full object-cover" />
      )}
    </div>
  </section>

  <!-- How it works -->
  {data.steps.length > 0 && (
    <section class="bg-cream">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <h2>How it works</h2>
        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          {data.steps.map((step, i) => (
            <div class="rounded-lg bg-white p-8 shadow-sm">
              <h3>{i + 1}. {step.title}</h3>
              <p class="mt-3">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Pricing -->
  {data.pricing && (
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
        <h2 class="text-3xl sm:text-4xl">
          {data.pricingHeading ?? "How much does mold testing cost?"}
        </h2>
        <p class="mt-6 max-w-2xl">{data.pricing}</p>
        {data.pricingLink && (
          <p class="mt-4">
            <a href={data.pricingLink.href} class="text-teal-500 underline">
              {data.pricingLink.label}
            </a>
          </p>
        )}
        <div class="mt-8">
          <a href="/request-free-estimate" class="btn-ghost">Get a free estimate</a>
        </div>
      </div>
    </section>
  )}

  <!-- Areas served -->
  {data.areas.length > 0 && (
    <section class="bg-white border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
        <h2 class="text-3xl sm:text-4xl">{data.areasHeading ?? `Serving ${data.state}`}</h2>
        <p class="mt-4">We proudly provide mold testing services in:</p>
        <ul class="mt-8 grid gap-x-12 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          {data.areas.map((area) => (
            <li class="text-sm font-semibold uppercase tracking-[3px] text-teal-800">{area}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- What the inspection includes — photo band with floating card -->
  {data.includes.length > 0 && (
    <section
      class="bg-cover bg-center"
      style="background-image: url('/images/moldcatchers/banner-21.jpg');"
    >
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <div class="max-w-xl rounded-xl bg-white p-8 shadow-lg sm:p-12">
          <h2 class="text-3xl sm:text-4xl">What does our mold inspection include?</h2>
          <p class="mt-4">
            Unlike companies that spend 10 minutes collecting air samples, we provide a thorough
            investigation including:
          </p>
          <div class="mt-8 space-y-6">
            {data.includes.map((item) => (
              <div>
                <h3 class="text-lg sm:text-xl">{item.title}</h3>
                <p class="mt-1">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Local mold signs — "Really? Mold, in <city>?" -->
  {data.signs.length > 0 && (
    <section class="bg-cream">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <h2>{data.signsHeading ?? `Really? Mold, in ${data.city ?? data.state}? Yes. Here's what we see.`}</h2>
        <div class="mt-12 grid gap-12 lg:grid-cols-2">
          <div class="space-y-12">
            {data.signs.map((sign) => (
              <div>
                <h3>{sign.title}</h3>
                <p class="mt-3">{sign.text}</p>
                {sign.why && (
                  <p class="mt-4">
                    <span aria-hidden="true">🔎</span>{" "}
                    <strong class="font-semibold">{sign.why.label}:</strong> {sign.why.text}
                  </p>
                )}
                {sign.local && (
                  <p class="mt-2">
                    <span aria-hidden="true">🏡</span>{" "}
                    <strong class="font-semibold">{sign.local.label}:</strong> {sign.local.text}
                  </p>
                )}
              </div>
            ))}
          </div>
          {data.signsImage && (
            <div class="hidden lg:block">
              <img
                src={data.signsImage.src}
                alt={data.signsImage.alt}
                class="sticky top-32 aspect-square w-full rounded-full object-cover"
                loading="lazy"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Value cards — teal tiles with an optional photo as the third cell -->
  {data.valueCards.length > 0 && (
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {data.valueCards.map((card) => (
            <div class="rounded-lg bg-teal-800 p-10 text-center">
              <h3 class="text-white">{card.title}</h3>
              <p class="mt-3 text-white/85">{card.text}</p>
            </div>
          ))}
          {data.valueCardsImage && (
            <img
              src={data.valueCardsImage.src}
              alt={data.valueCardsImage.alt}
              class="h-full w-full rounded-lg object-cover"
              loading="lazy"
            />
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Why <city> trusts us — floating card over a photo band -->
  {data.trust && (
    <section
      class="bg-cover bg-center"
      style={`background-image: url('${data.trust.image?.src ?? "/images/moldcatchers/banner-23.jpg"}');`}
    >
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <div class="max-w-xl rounded-xl bg-white p-8 shadow-lg sm:p-12">
          <h2 class="text-3xl sm:text-4xl">{data.trust.heading}</h2>
          <p class="mt-6">{data.trust.intro}</p>
          <div class="mt-8 space-y-6">
            {data.trust.points.map((point) => (
              <div>
                <h3 class="text-lg sm:text-xl">{point.title}</h3>
                <p class="mt-1">{point.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ — teal band -->
  {data.faqs.length > 0 && (
    <section class="bg-teal-800">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <h2 class="max-w-3xl text-white">{data.faqsHeading ?? "Mold questions"}</h2>
        <div class="mt-12 grid gap-x-12 gap-y-10 lg:grid-cols-2">
          {data.faqs.map((faq) => (
            <div>
              <h3 class="text-white">{faq.question}</h3>
              <p class="mt-3 text-white/85">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Mold types — dark navy band -->
  {data.molds.length > 0 && (
    <section class="bg-ink">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <h2 class="text-white">Molds found in {data.state}</h2>
        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {data.molds.map((mold) => (
            <div>
              <h3 class="text-white">{mold.name}</h3>
              <p class="mt-3 text-white/80">{mold.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Markdown body: expert services / why unbiased -->
  {hasBody && (
    <section class="bg-white">
      <div class="mx-auto max-w-3xl px-6 py-20 sm:py-24">
        <div class="prose">
          <Content />
        </div>
        <div class="mt-8">
          <a href="/request-free-estimate" class="btn-ghost">Pricing</a>
        </div>
      </div>
    </section>
  )}

  <!-- Closing CTA — floating card over a photo band, or a centered cream band -->
  {data.cta ? (
    <section
      class="bg-cover bg-center"
      style={`background-image: url('${data.cta.image?.src ?? "/images/moldcatchers/banner-21.jpg"}');`}
    >
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <div class="max-w-lg rounded-xl bg-white p-8 shadow-lg sm:p-12">
          <h2 class="text-3xl sm:text-4xl">{data.cta.heading}</h2>
          <p class="mt-6">{data.cta.text}</p>
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <a href="/request-free-estimate" class="btn-primary">Free Estimate</a>
            <a href={siteMeta.contact.phoneHref} class="text-sm font-semibold">
              Call us {siteMeta.contact.phone}
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-cream">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28 text-center">
        <h2>Schedule your mold inspection today</h2>
        <p class="mx-auto mt-6 max-w-2xl">
          Don't wait until mold becomes a bigger problem. Request a mold test pricing estimate or
          click below to schedule an appointment. Let us help you take the first step toward a
          healthier, mold-free environment.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/request-free-estimate" class="btn-primary">Schedule a consultation</a>
          <a href="/request-free-estimate" class="btn-ghost">Pricing</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
