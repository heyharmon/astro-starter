---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title="Blog" description="Latest posts, ideas, and updates.">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <h1>Blog</h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-500">
      Latest posts, ideas, and updates.
    </p>
  </section>

  <!-- Post list -->
  <section class="border-t border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
      {posts.length === 0 ? (
        <p class="text-neutral-500">No posts yet.</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="block rounded-xl border border-neutral-200 bg-white p-8 transition hover:border-neutral-400"
            >
              <time
                datetime={post.data.date.toISOString()}
                class="text-sm text-neutral-500"
              >
                {dateFormatter.format(post.data.date)}
              </time>
              <h3 class="mt-2">{post.data.title}</h3>
              <p class="mt-2 text-sm text-neutral-500">
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
