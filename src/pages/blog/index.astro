---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title="Blog" description="Demonstrates a content collection — chronological posts loaded from src/content/posts/.">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="text-sm uppercase tracking-wide text-neutral-500">
      Tier 2 / 3 — Content collection (chronological)
    </p>
    <h1 class="mt-4">Posts collection</h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-500">
      Each card below is a Markdown file in <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">src/content/posts/</code>.
      The schema lives in <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">src/content.config.ts</code>. Sorted by <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">date</code> descending.
      Drafts (<code class="rounded bg-neutral-100 px-1.5 py-0.5 text-base">draft: true</code>) are visible in dev and hidden in production.
    </p>
  </section>

  <!-- Post list -->
  <section class="border-t border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
      {posts.length === 0 ? (
        <p class="text-neutral-500">No posts yet. Add a Markdown file to <code>src/content/posts/</code>.</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="block rounded-xl border border-neutral-200 bg-white p-8 transition hover:border-neutral-400"
            >
              <div class="flex items-center gap-3">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-sm text-neutral-500"
                >
                  {dateFormatter.format(post.data.date)}
                </time>
                {post.data.draft && (
                  <span class="rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-xs text-amber-700">draft</span>
                )}
              </div>
              <h3 class="mt-2">{post.data.title}</h3>
              <p class="mt-2 text-sm text-neutral-500">
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
              <p class="mt-6 font-mono text-xs text-neutral-400">
                src/content/posts/{post.id}.md
              </p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
