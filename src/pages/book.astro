---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Book a call"
  description="Grab 15 minutes with Studio Harmon — a quick, no-pressure chat about your business and what a great website could do for it."
>
  <div class="wrap">
    <section class="split">
      <!-- Left -->
      <div class="lede">
        <a href="/" class="back"><span class="a">←</span> Back to home</a>
        <span class="eyebrow">Book a call</span>
        <h1 class="disp" style="margin-top:14px"><em>Grab</em> 15 minutes</h1>
        <p class="sub">
          A quick, no-pressure chat about your business and what a great website
          could do for it. You'll talk to the people who'd actually build it.
        </p>
        <div class="facts">
          <div class="fact">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"
              ></path></svg
            >
            <div>
              <b>15 minutes</b><span
                >Short and focused — we respect your time.</span
              >
            </div>
          </div>
          <div class="fact">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              ><path d="M15 10l4-4M21 3v6h-6"></path><rect
                x="3"
                y="6"
                width="13"
                height="14"
                rx="2"></rect></svg
            >
            <div>
              <b>Video or phone</b><span
                >We'll send a link once you book — your choice.</span
              >
            </div>
          </div>
          <div class="fact">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"><path d="M5 13l4 4L19 7"></path></svg
            >
            <div>
              <b>No commitment</b><span>Just helpful answers. Bring your questions.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right: scheduler -->
      <div class="sched">
        <div class="sched-body" id="schedBody">
          <div class="stitle">Pick a time that works</div>
          <div class="snote">All times Mountain Time (Salt Lake City).</div>

          <div class="slabel">Choose a day</div>
          <div class="days" id="days"></div>

          <div class="slabel">Choose a time</div>
          <div class="times" id="times"></div>

          <div class="frow">
            <div class="field">
              <label for="bname">Your name</label>
              <input id="bname" type="text" placeholder="Jordan Avery" />
            </div>
            <div class="field">
              <label for="bemail">Email</label>
              <input id="bemail" type="email" placeholder="you@business.com" />
            </div>
          </div>

          <div class="summary" id="summary">
            Select a day and time to continue.
          </div>

          <div class="confirm-row">
            <button id="confirmBtn" class="btn btn-clay" disabled
              >Confirm booking <span class="arr">→</span></button
            >
          </div>
        </div>

        <div class="done" id="done">
          <div class="check-mark">
            <svg
              width="30"
              height="30"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#fff"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M4 12l5 5L20 6"></path></svg
            >
          </div>
          <h3>You're booked!</h3>
          <div class="when" id="doneWhen"></div>
          <p>
            A calendar invite and meeting link are on their way to your inbox.
            Talk soon!
          </p>
          <a href="/" class="btn btn-ghost" style="margin-top:22px"
            >Back to home</a
          >
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Client-side scheduler prototype. Wire to your real scheduling provider
  // (Cal.com, Calendly, Google Calendar, etc.) when ready. Times are MT.
  const DOW = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const MON = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
  ];
  const TIMES = [
    "9:00 AM", "9:30 AM", "10:00 AM", "11:00 AM",
    "1:00 PM", "1:30 PM", "2:30 PM", "3:30 PM",
  ];

  let selTime: string | null = null;
  let selDayLabel = "";

  const daysEl = document.getElementById("days");
  const timesEl = document.getElementById("times");
  const summary = document.getElementById("summary");
  const btn = document.getElementById("confirmBtn") as HTMLButtonElement | null;

  function update() {
    if (!summary || !btn) return;
    if (selDayLabel && selTime) {
      summary.innerHTML =
        "Your call: <b>" + selDayLabel + "</b> at <b>" + selTime +
        " MT</b> · 15 minutes";
      btn.disabled = false;
    } else {
      summary.textContent = "Select a day and time to continue.";
      btn.disabled = true;
    }
  }

  // Build the next 5 weekdays from today
  const d = new Date();
  let added = 0;
  while (added < 5 && daysEl) {
    d.setDate(d.getDate() + 1);
    const dow = d.getDay();
    if (dow === 0 || dow === 6) continue;
    const label = DOW[dow] + ", " + MON[d.getMonth()] + " " + d.getDate();
    const el = document.createElement("div");
    el.className = "day";
    el.innerHTML =
      '<div class="dow">' + DOW[dow] + '</div><div class="dnum">' +
      d.getDate() + '</div><div class="dmon">' + MON[d.getMonth()] + "</div>";
    el.addEventListener("click", () => {
      document.querySelectorAll(".day").forEach((x) => x.classList.remove("sel"));
      el.classList.add("sel");
      selDayLabel = label;
      update();
    });
    daysEl.appendChild(el);
    added++;
  }

  // Build the time slots
  TIMES.forEach((t) => {
    if (!timesEl) return;
    const el = document.createElement("div");
    el.className = "time";
    el.textContent = t;
    el.addEventListener("click", () => {
      document.querySelectorAll(".time").forEach((x) => x.classList.remove("sel"));
      el.classList.add("sel");
      selTime = t;
      update();
    });
    timesEl.appendChild(el);
  });

  btn?.addEventListener("click", () => {
    const name = (document.getElementById("bname") as HTMLInputElement)?.value.trim();
    const email = (document.getElementById("bemail") as HTMLInputElement)?.value.trim();
    if (!name || !email) {
      alert("Please add your name and email so we can send the invite.");
      return;
    }
    const when = document.getElementById("doneWhen");
    if (when) when.textContent = selDayLabel + " · " + selTime + " MT";
    document.getElementById("schedBody")?.classList.add("hide");
    document.getElementById("done")?.classList.add("show");
  });
</script>
