---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteMeta from "../data/site-meta.json";

const projects = [
  {
    title: "Intermountain Hospital",
    slug: "intermountain",
    img: "/images/eaglepoint/project-intermountain.jpg",
    desc: "Precision medical equipment installation with zero-tolerance accuracy in live hospital environment.",
  },
  {
    title: "Black Desert Resort",
    slug: "black-desert",
    img: "/images/eaglepoint/project-black-desert.jpg",
    desc: "Custom luxury stair and balcony railings with laser-cut precision posts, hidden connections and elevator structural retrofit.",
  },
  {
    title: "Nyrstar Mines",
    slug: "nyrstar",
    img: "/images/eaglepoint/project-nyrstar.jpg",
    desc: "Heavy-duty mining repairs with AR-500 wear plate. Underground crusher retrofits and topside chute fabrication.",
  },
  {
    title: "Entrada at Snow Canyon",
    slug: "entrada",
    img: "/images/eaglepoint/project-entrada.jpg",
    desc: "Architectural metalwork featuring custom railings and grand entry door. Perfection demanded and delivered.",
  },
  {
    title: "DC Ranch – Ramona",
    slug: "ranch-fencing",
    img: "/images/eaglepoint/project-dc-ranch.jpg",
    desc: "Ranch buildout featuring custom entry gates, decorative signage, pipe rail corrals, and large-span equestrian shade pavilions.",
  },
];

const services = [
  {
    title: "Structural & Seismic",
    img: "/images/eaglepoint/service-structural.jpg",
    desc: "Heavy-gauge steel fabrication and seismic retrofitting for commercial and industrial applications. We handle complex structural challenges with engineering precision and certified expertise.",
  },
  {
    title: "Certified Rig/Mobile Welding",
    img: "/images/eaglepoint/service-rig-mobile.jpg",
    desc: "Mobile welding services bringing our expertise directly to your job site. From emergency repairs to scheduled maintenance, our certified welders deliver quality work wherever you need us.",
  },
  {
    title: "Pipe Welding",
    img: "/images/eaglepoint/service-pipe.jpg",
    desc: "Precision pipe fabrication and installation for mechanical, industrial, and medical systems. Zero-tolerance accuracy for critical applications — fit and welded to spec, every weld passing.",
  },
  {
    title: "Custom Homes",
    img: "/images/eaglepoint/service-custom-homes.jpg",
    desc: "Architectural metalwork that elevates luxury residences. Custom railings, grand entry doors, and decorative steel features crafted to perfection for St. George’s finest homes.",
  },
];
---

<BaseLayout
  title="Certified Welders in St. George, UT"
  description="Certified welding & metal fabrication in St. George, UT. Structural steel, pipe welding, custom railings, and mobile rig welding across Southern Utah."
>
  <!-- ===================== HERO ===================== -->
  <section
    id="top"
    class="relative flex min-h-[80vh] flex-col justify-end overflow-hidden lg:min-h-[82vh]"
  >
    <video
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      poster="/images/eaglepoint/hero-poster.jpg"
    >
      <source src="/images/eaglepoint/hero-video.mp4" type="video/mp4" />
    </video>
    <div
      class="absolute inset-0"
      style="background-image:linear-gradient(to bottom, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.5) 55%, rgba(0,0,0,0.35) 100%);"
    >
    </div>

    <div class="epw-container relative z-10 pt-28 pb-20 lg:pb-28">
      <p class="eyebrow text-white/90">The Standard in Metalwork</p>
      <h1
        class="mt-6 max-w-[42rem] text-[3.5rem] leading-[1.02] sm:text-[4.5rem] lg:text-[5rem]"
      >
        St. George’s<br class="hidden sm:block" /> Certified Welders
      </h1>
      <p class="mt-7 max-w-xl text-[21px] leading-relaxed text-ink">
        From hospital retrofits to luxury resorts and heavy industrial projects, we deliver
        precision welding and fabrication that exceeds expectations. Certified, experienced, and
        always on time.
      </p>
      <div class="mt-9">
        <a href="/contact" class="btn-outline">Get a quote</a>
      </div>
    </div>
  </section>

  <!-- ===================== LATEST PROJECTS ===================== -->
  <section id="projects" class="bg-surface py-20 lg:py-28">
    <div class="epw-container">
      <h2>Latest projects</h2>
      <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((p) => (
            <a href={`/projects/${p.slug}`} class="group flex flex-col">
              <div class="aspect-[3/2] overflow-hidden border border-white/10 bg-black">
                <img
                  src={p.img}
                  alt={p.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <h3 class="mt-5">{p.title}</h3>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink">{p.desc}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-[13px] font-semibold tracking-[1.5px] text-white uppercase">
                View project
                <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section id="services" class="bg-black py-20 lg:py-28">
    <div class="epw-container">
      <h2>Services</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          services.map((s) => (
            <article class="group relative flex min-h-[420px] overflow-hidden lg:min-h-[480px]">
              <img
                src={s.img}
                alt={s.title}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div
                class="absolute inset-0"
                style="background-image:linear-gradient(135deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.25) 100%);"
              />
              <div class="relative z-10 flex flex-col p-9 lg:p-10">
                <h3 class="text-[2rem]">{s.title}</h3>
                <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-ink">{s.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== REAL PICTURES ===================== -->
  <section class="relative overflow-hidden bg-black">
    <img
      src="/images/eaglepoint/real-pictures.jpg"
      alt="Modern home with custom metal railings and stairs"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="relative epw-container py-24 lg:py-32">
      <div class="max-w-md bg-black p-10 lg:p-12">
        <h2>Real pictures of our work.</h2>
        <p class="mt-5 text-[15px] leading-relaxed text-ink">
          From healthcare to hospitality, mining &amp; pipe welding to luxury homes—see how we
          deliver precision welding and fabrication that exceeds expectations.
        </p>
        <div class="mt-7">
          <a href="/projects" class="btn-outline btn-outline-sm">Explore projects</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section id="about" class="bg-surface py-20 lg:py-28">
    <div class="epw-container grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="max-w-md text-[2.5rem] leading-[1.05] lg:text-[3.25rem]">
          Metal is our common ground, Welding is our expression.
        </h2>
        <p class="eyebrow mt-8 text-white">Nick Coleman, Owner/Operator</p>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-ink">
          Eagle Point Welding brings decades of experience to Southern Utah’s most demanding
          projects. From sterile medical environments to underground mining operations, we approach
          every job with unwavering commitment to safety, quality, and precision. Our team thrives
          on challenges others won’t take on.
        </p>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden bg-black">
          <img
            src="/images/eaglepoint/about-welder.jpg"
            alt="Nick Coleman welding on site"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <span
          class="absolute right-4 bottom-4 text-[13px] font-medium tracking-[1px] text-white/90 uppercase"
        >
          Nick Coleman
        </span>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section id="contact" class="relative overflow-hidden bg-black">
    <img
      src="/images/eaglepoint/cta-bg.jpg"
      alt="Welding tools and equipment"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0"
      style="background-image:linear-gradient(to bottom, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.72) 100%);"
    >
    </div>
    <div class="relative epw-container py-24 text-center lg:py-28">
      <p class="eyebrow eyebrow--center">Get in touch</p>
      <h2 class="mt-5">What do you need to build?</h2>
      <p class="mx-auto mt-5 max-w-xl text-[17px] leading-relaxed text-ink">
        Tell us about your project. From structural steel to custom architectural metalwork, our
        certified team is ready to deliver — on spec and on time.
      </p>
      <div class="mt-9">
        <a href="/contact" class="btn-outline">Get a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
