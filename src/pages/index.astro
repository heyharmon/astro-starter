---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StatBand from "../components/StatBand.astro";
import FounderNote from "../components/FounderNote.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Placeholder from "../components/Placeholder.astro";
import Button from "../components/Button.astro";
import ProgramCard from "../components/ProgramCard.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Schedule from "../components/Schedule.astro";
import Testimonials from "../components/Testimonials.astro";
import BannerCta from "../components/BannerCta.astro";
import CtaBand from "../components/CtaBand.astro";
import siteMeta from "../data/site-meta.json";
import siteContent from "../data/site-content.json";

const {
  hero,
  stats,
  founder,
  approach,
  programsPreview,
  programs,
  features,
  schedule,
  testimonials,
  enrollmentCta,
  cta,
} = siteContent;
---

<BaseLayout title="Home" description={siteMeta.description}>
  <Hero {...hero} />

  <StatBand stats={stats} />

  <FounderNote {...founder} />

  <!-- Approach -->
  <section class="section approach">
    <div class="wrap approach-grid">
      <div class="approach-art">
        <Placeholder label={approach.images[0].label} ratio={approach.images[0].ratio} />
        <Placeholder label={approach.images[1].label} ratio={approach.images[1].ratio} />
      </div>
      <div>
        <span class="eyebrow">{approach.eyebrow}</span>
        <h2 class="approach-h">{approach.heading}</h2>
        <p class="lead">{approach.lead}</p>
        <p class="approach-body">{approach.body}</p>
        <Button href={approach.cta.href} variant="ghost" arrow class="approach-cta">
          {approach.cta.label}
        </Button>
      </div>
    </div>
  </section>

  <!-- Programs preview -->
  <section class="section programs-preview">
    <div class="wrap">
      <SectionHeading
        eyebrow={programsPreview.eyebrow}
        heading={programsPreview.heading}
        actionHref={programsPreview.cta.href}
        actionLabel={programsPreview.cta.label}
      />
      <div class="prog-grid">
        {programs.map((p) => <ProgramCard program={p} />)}
      </div>
    </div>
  </section>

  <FeatureGrid eyebrow={features.eyebrow} heading={features.heading} items={features.items} />

  <Schedule
    eyebrow={schedule.eyebrow}
    heading={schedule.heading}
    lead={schedule.lead}
    image={schedule.image}
    items={schedule.items}
  />

  <Testimonials
    eyebrow={testimonials.eyebrow}
    heading={testimonials.heading}
    rating={testimonials.rating}
    items={testimonials.items}
  />

  <BannerCta {...enrollmentCta} />

  <CtaBand heading={cta.heading} body={cta.body} button={cta.button} />
</BaseLayout>

<style>
  .approach-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .approach-h {
    font-size: var(--step-3);
    margin: 0.9rem 0 1.3rem;
  }
  .approach-body {
    margin-top: 1.1rem;
    color: var(--color-ink-soft);
  }
  .approach-cta {
    margin-top: 1.6rem;
  }
  .approach-art {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .approach-art :global(.ph):first-child {
    margin-top: 2.2rem;
  }
  @media (max-width: 820px) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Programs preview sits directly under the approach section */
  .programs-preview {
    padding-top: 0;
  }
  .prog-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-top: 2.6rem;
  }
  @media (max-width: 900px) {
    .prog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .prog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
