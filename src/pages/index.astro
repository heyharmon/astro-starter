---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteMeta from "../data/site-meta.json";

const reasons = [
  {
    title: "Health Symptoms",
    text: "Dealing with allergies, breathing problems, or headaches that seem worse when you're at home? Mold might be to blame, and testing can help you figure it out.",
  },
  {
    title: "Musty Odors",
    text: "Noticing a musty smell that won't go away? It could be mold growing in places like the basement, crawlspace, or behind the walls.",
  },
  {
    title: "Visible Mold Growth",
    text: "Seeing black spots, weird stains, or patches of discoloration on your walls or ceilings? That's a big red flag for mold, and there could be more hiding where you can't see.",
  },
  {
    title: "Water Damage",
    text: "Had a leak, flood, or condensation recently? Even if things look dry, leftover moisture can lead to hidden mold. Testing makes sure nothing's growing out of sight.",
  },
];

const steps = [
  { title: "1. Schedule", text: "Contact us to set up a convenient time for your mold inspection." },
  { title: "2. Test", text: "Our experts use advanced tools to thoroughly evaluate your property." },
  { title: "3. Get results", text: "Receive a detailed report explaining the findings and next steps." },
];
---

<BaseLayout title="Home" description={siteMeta.description}>
  <!-- Hero: split ice-blue panel + photo -->
  <section class="grid lg:grid-cols-2">
    <div class="order-2 flex items-center bg-ice lg:order-1">
      <div class="w-full px-6 py-20 sm:px-12 sm:py-32 lg:pl-[max(1.5rem,calc((100vw-72rem)/2))] lg:pr-16">
        <h1>Trusted, simple mold testing</h1>
        <p class="mt-6 max-w-md text-lg">
          We provide unbiased mold testing services. Unlike other companies, we have no financial
          interest in mold remediation. Our focus is informing you.
        </p>
        <div class="mt-8">
          <a href="/request-free-estimate" class="btn-primary">Free Estimate</a>
        </div>
      </div>
    </div>
    <div class="order-1 min-h-[320px] lg:order-2 lg:min-h-[720px]">
      <img
        src="/images/moldcatchers/brooke-cagle-XmWV_lQq6_c-unsplash-scaled.jpg"
        alt="Father and daughter relaxing in a bright, healthy home"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <!-- Do you need mold testing? — solid teal band -->
  <section class="bg-teal-800">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 sm:py-28 lg:grid-cols-3">
      <div>
        <h2 class="text-white">Do you need mold testing?</h2>
        <p class="mt-4 text-white/85">
          Consider a home mold test if you are experiencing any of the following:
        </p>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-2">
        {reasons.map((reason) => (
          <div>
            <h3 class="text-white">{reason.title}</h3>
            <p class="mt-3 text-white/85">{reason.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Peace of mind — cream band with collage -->
  <section class="bg-cream">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:py-28 lg:grid-cols-2">
      <div>
        <img
          src="/images/moldcatchers/feature-homepage.png"
          alt="Collage of a healthy family home and mold sample imagery"
          class="w-full"
        />
      </div>
      <div class="lg:px-8">
        <h2>Testing is about peace of mind</h2>
        <p class="mt-6">
          We offer honest, conflict-free mold inspections using advanced tools to detect hidden
          mold, with certified experts specializing in Northern Utah's unique needs.
        </p>
        <div class="mt-8">
          <a href="/request-free-estimate" class="btn-ghost">Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Independent tester — full-bleed photo with floating card -->
  <section
    class="bg-cover bg-center"
    style="background-image: url('/images/moldcatchers/patrick-perkins-3wylDrjxH-E-unsplash-scaled.jpg');"
  >
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-36">
      <div class="max-w-xl rounded-xl bg-white p-8 shadow-lg sm:p-12">
        <h2 class="text-3xl sm:text-4xl">The key is hiring an independent mold tester</h2>
        <p class="mt-6">
          Not all mold testing services are the same. Many companies that offer inspections also
          handle remediation, creating a conflict of interest. At Mold Catchers, we're different.
          Our sole focus is providing reliable, unbiased testing with no hidden agenda. Since we
          don't sell remediation services, you can trust our assessments are honest and designed
          to help you make informed decisions.
        </p>
        <div class="mt-8">
          <a href="/request-free-estimate" class="btn-primary">Free Estimate</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works — cream band, 3 cards -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <h2>How it works</h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {steps.map((step) => (
          <div class="rounded-lg bg-white p-8 shadow-sm">
            <h3>{step.title}</h3>
            <p class="mt-3">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Book your test — white band with collage -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:py-28 lg:grid-cols-2">
      <div>
        <img
          src="/images/moldcatchers/feature-global-cta.png"
          alt="Collage of home interiors and a petri dish mold sample"
          class="w-full"
        />
      </div>
      <div class="lg:px-8">
        <h2>Book your mold test today</h2>
        <p class="mt-6">
          Don't let mold turn into a bigger issue. Contact us for a free estimate or click below
          to schedule your appointment. Take the first step toward a healthier, mold-free home
          with our expert help.
        </p>
        <div class="mt-8">
          <a href="/request-free-estimate" class="btn-ghost">Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
