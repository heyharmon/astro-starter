---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteMeta from "../data/site-meta.json";

const work = [
  { name: "Allied Construction", tag: "Construction", url: "https://builtbyallied.com/", img: "/images/work/allied-construction.png" },
  { name: "Eagle Point Welding", tag: "Welding & fabrication", url: "https://eaglepointwelding.com/", img: "/images/work/eagle-point-welding.png" },
  { name: "Riley's Mailboxes", tag: "Home services", url: "https://www.rileysmailboxes.com/", img: "/images/work/rileys-mailboxes.png" },
  { name: "Western Quality Builds", tag: "Construction", url: "https://westernqualitybuilds.com/", img: "/images/work/western-quality-builds.png" },
  { name: "Vetframe", tag: "Veterinary", url: "https://vetframe.com/", img: "/images/work/vetframe.png" },
  { name: "Petstop Vet", tag: "Veterinary", url: "https://petstopvet.com/", img: "/images/work/petstop-vet.png" },
];
---

<BaseLayout title="Home" description={siteMeta.description}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow" style="display:block;margin-bottom:18px"
        >✦ &nbsp;An AI-native web studio</span
      >
      <h1 class="disp">
        Websites as <span class="mark-clay">ambitious</span> as the
        <span class="mark-clay">businesses</span> behind them.
      </h1>
      <div class="hero-sub-row">
        <p class="sub">
          We're a Salt Lake City studio building fast, modern websites that win
          customers. AI is our edge — so we'll build yours first and show you the
          real thing before you owe a cent.
        </p>
        <div class="cta-row">
          <a href="/start" class="btn btn-ink"
            >Start a project <span class="arr">→</span></a
          >
          <a href="/#how" class="btn btn-ghost">How it works</a>
        </div>
      </div>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        <span>Web Design</span><span>Development</span><span>SEO + GEO</span><span
          >ADA Compliance</span
        ><span>Unlimited Updates</span><span>24/7 Support</span><span
          >Hosting</span
        >
        <span>Web Design</span><span>Development</span><span>SEO + GEO</span><span
          >ADA Compliance</span
        ><span>Unlimited Updates</span><span>24/7 Support</span><span
          >Hosting</span
        >
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="pad" id="work">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="disp">Recent work.</h2>
        <p class="note">
          A range of businesses we've designed, built, and launched — across
          Utah and beyond.
        </p>
      </div>
      <div class="work">
        {
          work.map((p) => (
            <a class="wc" href={p.url} target="_blank" rel="noopener">
              <img
                class="wc-shot"
                src={`${p.img}?v=2`}
                alt={`${p.name} website`}
                width="1440"
                height="900"
                loading="lazy"
              />
              <div class="wc-body">
                <div>
                  <h3>{p.name}</h3>
                  <div class="tag">{p.tag}</div>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="wrap" id="how" style="padding:20px 32px 0">
    <div class="how">
      <span class="eyebrow">How it works</span>
      <h2 class="disp">We'd rather show you than tell you.</h2>
      <div class="how-steps">
        <div class="how-step">
          <div class="n">01</div>
          <h3>We design &amp; build it</h3>
          <p>
            Tell us about your business. Within days you get a complete, live
            website — the real thing, not a mockup.
          </p>
          <span class="pill">Free to start</span>
        </div>
        <div class="how-step">
          <div class="n">02</div>
          <h3>You review it</h3>
          <p>
            Explore every page on your own device. Want changes? We refine until
            it's right — as many rounds as it takes.
          </p>
          <span class="pill">No commitment</span>
        </div>
        <div class="how-step">
          <div class="n">03</div>
          <h3>Launch &amp; grow</h3>
          <p>
            We launch on your domain and keep it fast, current, and climbing in
            Google and AI search — unlimited updates anytime.
          </p>
          <span class="pill">$600 at launch</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="pad" id="services">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="disp">Everything a modern website should be.</h2>
        <p class="note">
          One studio for design, build, and growth — no handoffs, no agencies of
          agencies, no surprise invoices.
        </p>
      </div>
      <div class="svc-list">
        <div class="svc-row">
          <span class="ix">01</span>
          <h3>Designed to convert</h3>
          <p>
            Every layout, word, and detail built around one job — turning
            visitors into customers. Beautiful on the surface, engineered
            underneath.
          </p>
          <svg
            class="ic"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><rect x="3" y="4" width="18" height="14" rx="2"></rect><path
              d="M3 9h18"></path></svg
          >
        </div>
        <div class="svc-row">
          <span class="ix">02</span>
          <h3>Fast, flawless build</h3>
          <p>
            Sub-2-second load times and clean code — flawless on mobile, tablet,
            and desktop, so you never lose a visitor.
          </p>
          <svg
            class="ic"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"><path d="M4 12l4 4 8-10"></path></svg
          >
        </div>
        <div class="svc-row">
          <span class="ix">03</span>
          <h3>Found on Google — and cited by AI</h3>
          <p>
            SEO + GEO built into every page, then tuned by AI — so you show up
            when customers search the old way and get cited when they ask
            ChatGPT, Perplexity, and Google AI.
          </p>
          <svg
            class="ic"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><circle cx="11" cy="11" r="7"></circle><path d="M16 16l5 5"
            ></path></svg
          >
        </div>
        <div class="svc-row">
          <span class="ix">04</span>
          <h3>ADA compliant</h3>
          <p>
            Accessible to every visitor and protected from compliance risk —
            built in from day one.
          </p>
          <svg
            class="ic"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><circle cx="12" cy="12" r="9"></circle><path d="M8 12a4 4 0 0 1 8 0"
            ></path></svg
          >
        </div>
        <div class="svc-row">
          <span class="ix">05</span>
          <h3>24/7 support &amp; hosting</h3>
          <p>
            We host, secure, and monitor everything with AI plus humans. Need a
            change at midnight? It usually ships same day.
          </p>
          <svg
            class="ic"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"
            ></path></svg
          >
        </div>
      </div>
    </div>
  </section>

  <!-- METRICS -->
  <section class="pad" style="padding-top:0">
    <div class="wrap">
      <div class="metrics">
        <div class="sec-head">
          <h2 class="disp">Faster, cheaper, better — because AI.</h2>
          <p class="note">
            What that leverage means in practice. Numbers from recent launches —
            yours will be your own.
          </p>
        </div>
        <div class="mgrid">
          <div class="metric">
            <b>5–7 days</b><span>to your first live preview</span>
          </div>
          <div class="metric">
            <b>1/10th</b><span>of a typical agency price</span>
          </div>
          <div class="metric"><b>24/7</b><span>AI + human monitoring</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="wrap" id="pricing" style="padding:0 32px">
    <div>
      <div class="sec-head">
        <h2 class="disp">Simple, honest, and a fraction of the cost.</h2>
        <p class="note">
          One flat build price, half off with a membership. Unlimited
          everything. Cancel anytime.
        </p>
      </div>
      <div class="price">
        <div class="pc">
          <span class="kicker">The build</span>
          <div class="price-big">$1,200</div>
          <div class="per">once, at launch — or $600 with a membership</div>
          <h3>Your whole website</h3>
          <p>
            Design, build, copywriting, and launch — however many pages and
            revisions it takes. The price never changes, and you only pay once
            you've seen it and decided to launch.
          </p>
          <ul class="ul">
            <li>Unlimited pages</li>
            <li>Unlimited revisions</li>
            <li>Free until you launch</li>
          </ul>
          <a href="/start" class="btn btn-ink"
            >Start a project <span class="arr">→</span></a
          >
        </div>
        <div class="pc feature">
          <span class="kicker">Most popular · build 50% off</span>
          <div class="price-big">$80<span style="font-size:20px">/mo</span></div>
          <div class="per">ongoing membership · build drops to $600</div>
          <h3>Ongoing</h3>
          <p>
            Your website, always growing. Unlimited SEO + GEO, content, and
            changes — run by AI and tuned by our team. Join and your build is
            half off, $600 instead of $1,200.
          </p>
          <ul class="ul">
            <li>Unlimited SEO + GEO</li>
            <li>Unlimited pages &amp; content</li>
            <li>Unlimited revisions &amp; updates</li>
            <li>Blog posts, new pages, anything</li>
            <li>Build 50% off — $600</li>
          </ul>
          <a href="/start" class="btn btn-clay"
            >Get started <span class="arr">→</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- STUDIO -->
  <section class="pad" id="studio">
    <div class="wrap studio">
      <div>
        <img
          class="studio-photo"
          src="/images/slc.jpg?v=3"
          alt="Snow-covered Wasatch mountains and forest above Salt Lake City"
          width="1600"
          height="1200"
          loading="lazy"
        />
      </div>
      <div>
        <span class="eyebrow">The studio</span>
        <p class="quote" style="margin-top:18px">
          Small businesses deserve websites <em>as good as the big brands</em> —
          without the price tag or the wait.
        </p>
        <p class="by">
          <b>Studio Harmon</b> is a design studio in Salt Lake City, building for
          businesses across the country. AI is our unfair advantage — it lets us
          deliver work that rivals the big agencies, at a speed and price they
          can't match. You work directly with us from first sketch to launch,
          and we stay with you long after.
        </p>
        <a href="/start" class="btn btn-ghost" style="margin-top:26px"
          >Meet the team <span class="arr">→</span></a
        >
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap" style="padding:0 32px">
    <div class="cta">
      <span class="eyebrow">Start a project</span>
      <h2 class="disp" style="margin-top:16px">
        Let's build something<br />worth showing off.
      </h2>
      <p>
        Tell us about your business and we'll design a real, finished website. No
        pitch, no deposit — you decide where it goes from there.
      </p>
      <div class="cta-row">
        <a href="/start" class="btn btn-ink"
          >Start a project <span class="arr">→</span></a
        >
        <a href="/book" class="btn btn-ghost">Book a 15-min call</a>
      </div>
    </div>
  </section>
</BaseLayout>
