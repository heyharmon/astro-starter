---
/**
 * Styleguide — Eagle Point Welding Design System
 *
 * Living reference for the dark, monochrome, industrial system.
 * Imports the same global.css as every page, so what you see here is what ships.
 *
 * Layer 1: Foundations (surfaces, text, type scale, eyebrow, buttons, borders)
 * Layer 2: Component patterns (hero, project card, service tile, image band, about split, CTA)
 *
 * Machine-readable mirror: src/data/design-tokens.json
 * Agents: append new component patterns above the "NEW PATTERNS BELOW" marker.
 */
import Header from "../components/Header.astro";
import "../styles/global.css";

const Label = "mb-3 text-xs uppercase tracking-[1.5px] text-ink-dim";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Styleguide — Eagle Point Welding</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Work+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />

    <!-- Intro -->
    <section class="epw-container pt-32 pb-16">
      <p class="eyebrow">Design System</p>
      <h1 class="mt-5 text-[3rem] lg:text-[3.75rem]">Eagle Point Styleguide</h1>
      <p class="mt-5 max-w-2xl text-[17px] text-ink">
        The single reference for building new pages. Dark, monochrome, industrial. Two typefaces,
        square edges, no shadows, no accent color — depth comes from photography and dark gradient
        overlays. Everything here imports the same <code class="text-white">global.css</code> that ships.
      </p>
    </section>

    <!-- ===================================================== -->
    <!-- LAYER 1 — FOUNDATIONS                                 -->
    <!-- ===================================================== -->
    <section class="border-t border-line bg-surface">
      <div class="epw-container py-16">
        <p class="eyebrow">Layer 1</p>
        <h2 class="mt-4">Foundations</h2>

        <!-- Surfaces -->
        <h3 class="mt-12 mb-6">Surfaces</h3>
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <div class="h-24 border border-white/15 bg-black"></div>
            <p class="mt-2 text-sm text-white">Base · #000000</p>
            <p class="text-xs text-ink-dim">bg-black</p>
          </div>
          <div>
            <div class="h-24 border border-white/15 bg-surface"></div>
            <p class="mt-2 text-sm text-white">Alt · #191919</p>
            <p class="text-xs text-ink-dim">bg-surface</p>
          </div>
          <div>
            <div class="flex h-24 items-center justify-center border border-white/15 bg-black">
              <span class="h-12 w-24 border border-line bg-black"></span>
            </div>
            <p class="mt-2 text-sm text-white">Hairline · #2a2a2a</p>
            <p class="text-xs text-ink-dim">border-line</p>
          </div>
        </div>

        <!-- Text -->
        <h3 class="mt-14 mb-6">Text</h3>
        <div class="space-y-3">
          <p class="text-[17px] text-white">Heading / emphasis — #ffffff (text-white)</p>
          <p class="text-[17px] text-ink">Body copy — #d6d6d6 (text-ink)</p>
          <p class="text-[17px] text-ink-dim">Muted / captions — #9a9a9a (text-ink-dim)</p>
        </div>
      </div>
    </section>

    <!-- Typography -->
    <section class="border-t border-line bg-black">
      <div class="epw-container py-16">
        <h2>Typography</h2>
        <p class="mt-4 max-w-2xl text-[15px] text-ink">
          <span class="text-white">Bebas Neue</span> (display) for all headings —
          uppercase-only, condensed. <span class="text-white">Work Sans</span> for everything else.
        </p>

        <div class="mt-12 space-y-10">
          <div>
            <p class={Label}>H1 · Bebas Neue · clamp → 70px (hero overrides to 80px)</p>
            <h1>Forged to last</h1>
          </div>
          <div>
            <p class={Label}>H2 · Bebas Neue · section heading</p>
            <h2>Latest projects</h2>
          </div>
          <div>
            <p class={Label}>H3 · Bebas Neue · 30px · card & tile titles</p>
            <h3>Structural &amp; Seismic</h3>
          </div>
        </div>

        <div class="mt-12 max-w-2xl space-y-8">
          <div>
            <p class={Label}>Body · Work Sans · 17px · text-ink</p>
            <p class="text-[17px]">
              From hospital retrofits to luxury resorts and heavy industrial projects, we deliver
              precision welding and fabrication that exceeds expectations.
            </p>
          </div>
          <div>
            <p class={Label}>Eyebrow · .eyebrow · Work Sans 15px, uppercase, dash</p>
            <p class="eyebrow">The Standard in Metalwork</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Buttons -->
    <section class="border-t border-line bg-surface">
      <div class="epw-container py-16">
        <h2>Buttons</h2>
        <p class="mt-4 text-[15px] text-ink">
          One button: white, square, uppercase. Hover inverts to a transparent white outline.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href="#0" class="btn-outline">Get a quote</a>
          <a href="#0" class="btn-outline btn-outline-sm">View project</a>
        </div>
        <p class="mt-6 text-xs text-ink-dim">.btn-outline · .btn-outline-sm (cards)</p>
      </div>
    </section>

    <!-- ===================================================== -->
    <!-- LAYER 2 — COMPONENT PATTERNS                          -->
    <!-- ===================================================== -->
    <section class="border-t border-line bg-black">
      <div class="epw-container py-16">
        <p class="eyebrow">Layer 2</p>
        <h2 class="mt-4">Component Patterns</h2>
        <p class="mt-4 max-w-2xl text-[15px] text-ink">
          The building blocks of every page. Grows as new layouts introduce new patterns.
        </p>
      </div>
    </section>

    <!-- PATTERN: hero-video -->
    <section class="border-t border-line">
      <p class={`${Label} epw-container pt-10`}>PATTERN: hero-video</p>
      <div class="relative flex min-h-[60vh] flex-col justify-end overflow-hidden">
        <img
          src="/images/eaglepoint/hero-poster.jpg"
          alt="Hero background"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0"
          style="background-image:linear-gradient(to bottom, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.5) 55%, rgba(0,0,0,0.35) 100%);"
        >
        </div>
        <div class="epw-container relative z-10 pb-16">
          <p class="eyebrow text-white/90">The Standard in Metalwork</p>
          <h1 class="mt-5 max-w-[40rem] text-[3rem] leading-[1.02] sm:text-[4rem]">
            St. George’s<br class="hidden sm:block" /> Certified Welders
          </h1>
          <p class="mt-5 max-w-xl text-[19px] text-ink">
            Precision welding and fabrication that exceeds expectations.
          </p>
          <a href="#0" class="btn-outline mt-7">Get a quote</a>
        </div>
      </div>
    </section>

    <!-- PATTERN: project-card -->
    <section class="border-t border-line bg-surface">
      <div class="epw-container py-16">
        <p class={Label}>PATTERN: project-card</p>
        <article class="group flex max-w-sm flex-col">
          <div class="aspect-[3/2] overflow-hidden border border-white/10 bg-black">
            <img
              src="/images/eaglepoint/project-intermountain.png"
              alt="Project"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <h3 class="mt-5">Intermountain Hospital</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink">
            Precision medical equipment installation with zero-tolerance accuracy in live hospital
            environment.
          </p>
          <a href="#0" class="btn-outline btn-outline-sm mt-5 self-start">View project</a>
        </article>
      </div>
    </section>

    <!-- PATTERN: service-tile -->
    <section class="border-t border-line bg-black">
      <div class="epw-container py-16">
        <p class={Label}>PATTERN: service-tile</p>
        <article class="group relative flex min-h-[420px] max-w-xl overflow-hidden">
          <img
            src="/images/eaglepoint/service-structural.jpg"
            alt="Service"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div
            class="absolute inset-0"
            style="background-image:linear-gradient(135deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.25) 100%);"
          >
          </div>
          <div class="relative z-10 flex flex-col p-9">
            <h3 class="text-[2rem]">Structural &amp; Seismic</h3>
            <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-ink">
              Heavy-gauge steel fabrication and seismic retrofitting for commercial and industrial
              applications.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- PATTERN: image-panel-band -->
    <section class="border-t border-line">
      <p class={`${Label} epw-container pt-10`}>PATTERN: image-panel-band</p>
      <div class="relative overflow-hidden bg-black">
        <img
          src="/images/eaglepoint/real-pictures.jpg"
          alt="Band background"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="relative epw-container py-20">
          <div class="max-w-md bg-black p-10">
            <h2>Real pictures of our work.</h2>
            <p class="mt-5 text-[15px] leading-relaxed text-ink">
              A solid black panel offset to the container’s left edge, over a full-bleed photo.
            </p>
            <a href="#0" class="btn-outline btn-outline-sm mt-7">Explore projects</a>
          </div>
        </div>
      </div>
    </section>

    <!-- PATTERN: about-split -->
    <section class="border-t border-line bg-surface">
      <div class="epw-container py-16">
        <p class={Label}>PATTERN: about-split</p>
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <h2 class="max-w-md text-[2.5rem] leading-[1.05]">
              Metal is our common ground, Welding is our expression.
            </h2>
            <p class="eyebrow mt-8 text-white">Nick Coleman, Owner/Operator</p>
            <p class="mt-5 max-w-md text-[15px] leading-relaxed text-ink">
              Left column carries the Bebas headline, an eyebrow byline, and body copy.
            </p>
          </div>
          <div class="relative">
            <div class="aspect-[4/3] overflow-hidden bg-black">
              <img
                src="/images/eaglepoint/about-welder.jpg"
                alt="About"
                class="h-full w-full object-cover"
              />
            </div>
            <span
              class="absolute right-4 bottom-4 text-[13px] font-medium tracking-[1px] text-white/90 uppercase"
            >
              Nick Coleman
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- PATTERN: cta-centered -->
    <section class="border-t border-line">
      <p class={`${Label} epw-container pt-10`}>PATTERN: cta-centered</p>
      <div class="relative overflow-hidden bg-black">
        <img
          src="/images/eaglepoint/cta-bg.jpg"
          alt="CTA background"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0"
          style="background-image:linear-gradient(to bottom, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.72) 100%);"
        >
        </div>
        <div class="relative epw-container py-20 text-center">
          <p class="eyebrow eyebrow--center">Get in touch</p>
          <h2 class="mt-5">What do you need to build?</h2>
          <p class="mx-auto mt-5 max-w-xl text-[17px] text-ink">
            Centered eyebrow, headline, body, and outline button over a gradient-scrimmed photo.
          </p>
          <a href="#0" class="btn-outline mt-8">Get a quote</a>
        </div>
      </div>
    </section>

    <!-- NEW PATTERNS BELOW -->
  </body>
</html>
