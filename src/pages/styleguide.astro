---
/**
 * Styleguide — Maplewood design-system preview.
 *
 * Renders the token contract (colors, type scale, buttons, form,
 * placeholder) and live previews of the shared components, all from
 * the same global.css every page uses. This is the fastest way to
 * verify a THEME branch: re-skin tokens + fonts, reload this page,
 * and confirm every primitive and component picked up the new look.
 * Not in nav; noindex.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Placeholder from "../components/Placeholder.astro";
import StatBand from "../components/StatBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProgramCard from "../components/ProgramCard.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Schedule from "../components/Schedule.astro";
import Testimonials from "../components/Testimonials.astro";
import ValueGrid from "../components/ValueGrid.astro";
import TeamGrid from "../components/TeamGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import siteContent from "../data/site-content.json";
import "../styles/global.css";

const colorTokens = [
  "--color-bg",
  "--color-surface",
  "--color-surface-2",
  "--color-ink",
  "--color-ink-soft",
  "--color-primary",
  "--color-primary-d",
  "--color-accent",
  "--color-accent-2",
  "--color-line",
  "--color-blue",
  "--color-green",
];

const typeSteps = [
  { token: "--step-4", label: "step-4 · display / hero" },
  { token: "--step-3", label: "step-3 · section heading" },
  { token: "--step-2", label: "step-2" },
  { token: "--step-1", label: "step-1 · card title" },
  { token: "--step-0", label: "step-0 · body" },
  { token: "--step--1", label: "step--1 · eyebrow / small" },
];

const { stats, programs, features, schedule, testimonials } = siteContent;
const aboutValues = siteContent.pages.about.values;
const aboutTeam = siteContent.pages.about.team;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Styleguide · Maplewood Design System</title>
  </head>
  <body>
    <Header />

    <div class="wrap sg-intro">
      <Eyebrow>Styleguide</Eyebrow>
      <h1>Maplewood design system</h1>
      <p class="lead">
        Every token and component below reads from the same <code>global.css</code> as the live
        site. To verify a theme branch: swap the token values + fonts, reload, and check that this
        page re-skins end to end.
      </p>
    </div>

    <!-- COLOR TOKENS -->
    <section class="wrap sg-section">
      <h2>Color tokens</h2>
      <div class="sg-swatches">
        {
          colorTokens.map((t) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background: var(${t});`}></div>
              <code>{t.replace("--color-", "")}</code>
            </div>
          ))
        }
      </div>
    </section>

    <!-- TYPE SCALE -->
    <section class="wrap sg-section">
      <h2>Type scale &amp; fonts</h2>
      <p class="sg-note">
        Display font sets headings; body font sets text. Sizes use the fluid <code>--step-*</code> scale.
      </p>
      <div class="sg-type">
        {
          typeSteps.map((s) => (
            <div class="sg-type-row">
              <span class="sg-type-label">{s.label}</span>
              <span class="sg-type-sample" style={`font-size: var(${s.token});`}>
                Where little ones grow, play, and belong.
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- BUTTONS, EYEBROW, ACCENT -->
    <section class="wrap sg-section">
      <h2>Buttons &amp; labels</h2>
      <div class="sg-row">
        <Button href="#0" variant="primary" arrow>Book a tour</Button>
        <Button href="#0" variant="ghost" arrow>Explore programs</Button>
        <Button href="#0" variant="ghost">Ghost</Button>
      </div>
      <div class="sg-row" style="margin-top:1.5rem;">
        <Eyebrow>Eyebrow label</Eyebrow>
      </div>
      <p style="margin-top:1.5rem;">
        Headline with an <em class="accent">accent</em> word seam.
      </p>
    </section>

    <!-- PLACEHOLDER -->
    <section class="wrap sg-section">
      <h2>Image placeholders</h2>
      <div class="sg-ph-grid">
        <Placeholder label="4:5" ratio="4/5" />
        <Placeholder label="4:3" ratio="4/3" />
        <Placeholder label="1:1" ratio="1/1" />
        <Placeholder label="Blob" ratio="1/1" variant="blob" />
      </div>
    </section>

    <!-- FORM -->
    <section class="wrap sg-section">
      <h2>Form</h2>
      <div style="max-width: 32rem;">
        <div class="form-card">
          <div class="field">
            <label for="sg-text">Text input</label>
            <input id="sg-text" type="text" placeholder="Placeholder text" />
          </div>
          <div class="field">
            <label for="sg-select">Select</label>
            <select id="sg-select"><option>Option one</option><option>Option two</option></select>
          </div>
          <div class="field">
            <label for="sg-area">Textarea</label>
            <textarea id="sg-area" rows="3" placeholder="Placeholder text"></textarea>
          </div>
          <button type="button" class="btn btn-primary form-submit">Submit <span class="arr">→</span></button>
        </div>
      </div>
    </section>

    <!-- LIVE COMPONENTS -->
    <div class="wrap sg-section">
      <h2>Components</h2>
      <p class="sg-note">Live previews rendered with real content data.</p>
    </div>

    <StatBand stats={stats} />

    <section class="section">
      <div class="wrap">
        <SectionHeading
          eyebrow="Programs"
          heading="Program cards"
          actionHref="#0"
          actionLabel="All programs"
        />
        <div class="sg-prog-grid">
          {programs.map((p) => <ProgramCard program={p} />)}
        </div>
      </div>
    </section>

    <FeatureGrid eyebrow={features.eyebrow} heading={features.heading} items={features.items} />
    <Schedule
      eyebrow={schedule.eyebrow}
      heading={schedule.heading}
      lead={schedule.lead}
      image={schedule.image}
      items={schedule.items}
    />
    <ValueGrid eyebrow={aboutValues.eyebrow} heading={aboutValues.heading} items={aboutValues.items} />
    <TeamGrid eyebrow={aboutTeam.eyebrow} heading={aboutTeam.heading} members={aboutTeam.members} />
    <Testimonials
      eyebrow={testimonials.eyebrow}
      heading={testimonials.heading}
      items={testimonials.items}
    />
    <CtaBand
      heading="Come see Maplewood for yourself."
      body="Book a private tour and meet the educators who will care for your child."
      button={{ label: "Book a tour", href: "#0" }}
    />

    <Footer />

    <style>
      .sg-intro {
        padding-block: clamp(2.5rem, 5vw, 4rem) 1rem;
      }
      .sg-intro h1 {
        font-size: var(--step-3);
        margin: 0.8rem 0 1rem;
      }
      .sg-section {
        padding-block: clamp(2rem, 4vw, 3rem);
        border-top: 1px solid var(--color-line);
      }
      .sg-section > h2 {
        font-size: var(--step-2);
        margin-bottom: 1.5rem;
      }
      .sg-note {
        color: var(--color-ink-soft);
        margin-bottom: 1.5rem;
      }
      code {
        font-family: ui-monospace, monospace;
        font-size: 0.85em;
        background: var(--color-surface-2);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
      }
      .sg-swatches {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 1rem;
      }
      .sg-chip {
        height: 64px;
        border-radius: var(--radius);
        border: 1px solid var(--color-line);
        margin-bottom: 0.5rem;
      }
      .sg-type-row {
        display: flex;
        align-items: baseline;
        gap: 1.5rem;
        padding-block: 0.6rem;
        border-bottom: 1px solid var(--color-line);
      }
      .sg-type-label {
        flex: none;
        width: 200px;
        font-size: 0.8rem;
        color: var(--color-ink-soft);
      }
      .sg-type-sample {
        font-family: var(--font-display);
        line-height: 1.1;
      }
      .sg-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }
      .sg-ph-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
      }
      .sg-prog-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.2rem;
        margin-top: 2rem;
      }
      @media (max-width: 720px) {
        .sg-ph-grid,
        .sg-prog-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .sg-type-label {
          width: 120px;
        }
      }
    </style>
  </body>
</html>
