---
/**
 * Styleguide — Design System Preview
 *
 * Development-only page for reviewing the visual design system.
 * Not included in navigation. Renders all design atoms and component patterns
 * using the same tokens and styles as the live site.
 *
 * Agents: When adding new component patterns during page building,
 * append a new section above the "NEW PATTERNS BELOW" comment at the bottom.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Styleguide — Design System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />

    <!-- ============================================ -->
    <!-- LAYER 1: ATOMIC TOKENS                       -->
    <!-- ============================================ -->

    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <h1 class="text-4xl sm:text-5xl">Style Guide</h1>
      <p class="mt-4 max-w-2xl">
        The Mold Catchers design system, extracted from moldcatchers.com. CSS source of truth is
        <code class="rounded bg-surface px-1.5 py-0.5 text-sm">src/styles/global.css</code>; the
        machine-readable copy lives in
        <code class="rounded bg-surface px-1.5 py-0.5 text-sm">src/data/design-tokens.json</code>.
      </p>
    </section>

    <!-- Colors -->
    <section class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl sm:text-3xl">Colors</h2>
        <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
          <div>
            <div class="h-16 rounded bg-teal-800"></div>
            <p class="mt-2 text-xs">teal-800 #004c4c — primary</p>
          </div>
          <div>
            <div class="h-16 rounded bg-teal-700"></div>
            <p class="mt-2 text-xs">teal-700 #006352 — button hover</p>
          </div>
          <div>
            <div class="h-16 rounded bg-teal-500"></div>
            <p class="mt-2 text-xs">teal-500 #008787 — link hover</p>
          </div>
          <div>
            <div class="h-16 rounded bg-copper"></div>
            <p class="mt-2 text-xs">copper #a66d3f — accent</p>
          </div>
          <div>
            <div class="h-16 rounded border border-neutral-200 bg-cream"></div>
            <p class="mt-2 text-xs">cream #fbf7f3 — warm band</p>
          </div>
          <div>
            <div class="h-16 rounded border border-neutral-200 bg-ice"></div>
            <p class="mt-2 text-xs">ice #f5f8f8 — hero panel</p>
          </div>
          <div>
            <div class="h-16 rounded border border-neutral-200 bg-surface"></div>
            <p class="mt-2 text-xs">surface #f2f3f5 — cool band</p>
          </div>
          <div>
            <div class="h-16 rounded bg-ink"></div>
            <p class="mt-2 text-xs">ink #212934 — dark band</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Typography -->
    <section class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl sm:text-3xl">Typography — Manrope</h2>
        <div class="mt-8 space-y-10">
          <div>
            <p class="mb-2 text-xs text-neutral-400">H1 — font-semibold / text-4xl sm:text-7xl</p>
            <h1>Trusted, simple mold testing</h1>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-400">H2 — font-semibold / text-3xl sm:text-5xl</p>
            <h2>Do you need mold testing?</h2>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-400">H3 — font-semibold / text-xl sm:text-2xl</p>
            <h3>How it works</h3>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-400">Body — 17px / 1.9 line-height / teal-800</p>
            <p class="max-w-2xl">
              We provide unbiased mold testing services. Unlike other companies, we have no
              financial interest in mold remediation. Our focus is informing you.
            </p>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-400">Eyebrow — uppercase / 3px letter-spacing / copper</p>
            <p class="text-sm font-semibold uppercase tracking-[3px] text-copper">What's next?</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Buttons -->
    <section class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl sm:text-3xl">Buttons</h2>
        <div class="mt-8 flex flex-wrap items-start gap-6">
          <div>
            <a href="#0" class="btn-primary">Free Estimate</a>
            <p class="mt-2 text-xs text-neutral-400">.btn-primary</p>
          </div>
          <div>
            <a href="#0" class="btn-ghost">Pricing</a>
            <p class="mt-2 text-xs text-neutral-400">.btn-ghost (copper outline)</p>
          </div>
          <div class="rounded bg-teal-800 p-4">
            <a href="#0" class="btn-inverse">Free Estimate</a>
            <p class="mt-2 text-xs text-white/70">.btn-inverse (on teal)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Form inputs -->
    <section class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl sm:text-3xl">Form inputs</h2>
        <div class="mt-8 max-w-md space-y-6">
          <div>
            <label class="block text-sm font-semibold text-teal-800">Email address</label>
            <input
              type="email"
              placeholder="you@example.com"
              class="mt-2 block w-full rounded-[5px] border border-neutral-300 bg-white px-4 py-3 text-sm text-teal-800 placeholder-neutral-400 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-teal-800">Number of rooms in house</label>
            <select
              class="mt-2 block w-full rounded-[5px] border border-neutral-300 bg-white px-4 py-3 text-sm text-teal-800 focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
            >
              <option>1-2</option>
              <option>3-4</option>
              <option>5+</option>
            </select>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- LAYER 2: COMPONENT PATTERNS                  -->
    <!-- ============================================ -->

    <!-- Section bands -->
    <section class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl sm:text-3xl">Section bands</h2>
        <p class="mt-4 max-w-2xl">
          Pages alternate full-width color bands: white → teal-800 → cream → photo band with a
          floating white card → cream → white → teal footer.
        </p>
      </div>
      <div class="bg-teal-800 px-6 py-12">
        <div class="mx-auto max-w-6xl">
          <h3 class="text-white">Teal band — white text</h3>
          <p class="mt-2 text-white/85">Used for "Do you need mold testing?" and FAQ sections.</p>
        </div>
      </div>
      <div class="bg-cream px-6 py-12">
        <div class="mx-auto max-w-6xl">
          <h3>Cream band</h3>
          <p class="mt-2">Used for "How it works" and peace-of-mind sections.</p>
        </div>
      </div>
      <div class="bg-ink px-6 py-12">
        <div class="mx-auto max-w-6xl">
          <h3 class="text-white">Ink band</h3>
          <p class="mt-2 text-white/80">Used for "Molds found in Utah".</p>
        </div>
      </div>
      <div class="bg-surface px-6 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-md rounded-xl bg-white p-8 shadow-lg">
            <h3>Floating card</h3>
            <p class="mt-2">White card with soft shadow, used over full-bleed photo bands.</p>
          </div>
        </div>
      </div>
      <div class="bg-cream px-6 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-8 sm:grid-cols-3">
            <div class="rounded-lg bg-white p-8 shadow-sm">
              <h3>1. Schedule</h3>
              <p class="mt-3">Numbered step card — white on cream, soft shadow.</p>
            </div>
            <div class="rounded-lg bg-white p-8 shadow-sm">
              <h3>2. Test</h3>
              <p class="mt-3">Heading plus one line of copy.</p>
            </div>
            <div class="rounded-lg bg-white p-8 shadow-sm">
              <h3>3. Get results</h3>
              <p class="mt-3">Used in every "How it works" section.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- NEW PATTERNS BELOW -->

    <Footer />
  </body>
</html>
