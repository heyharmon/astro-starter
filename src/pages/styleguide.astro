---
/**
 * Style Guide — Studio Harmon design system (living documentation).
 * Browsable in-repo reference for tokens, color, type, components, and rules.
 * Not in primary nav. Build every new page from what's documented here.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const tokens = [
  ["--bg", "#0B0C0E", "Page background (near-black)"],
  ["--bg-2", "#111316", "Raised surface / hover"],
  ["--card", "#0F1114", "Cards, frames, panels"],
  ["--ink", "#EEF0F2", "Primary text + headings"],
  ["--ink-2", "#9AA1A9", "Body / secondary text"],
  ["--ink-3", "#666D75", "Muted labels, captions, meta"],
  ["--line", "rgba(238,240,242,.10)", "Hairline borders, dividers"],
  ["--line-2", "rgba(238,240,242,.20)", "Stronger borders, outlines"],
  ["--ember", "#EE9A17", "Accent — CTAs, logo, markers, glow"],
  ["--ember-2", "#F1AC41", "Accent hover / lightened"],
  ["--on-accent", "#0B0C0E", "Text/icon on an accent fill"],
  ["--maxw", "1220px", "Content container width"],
];

const swatches = [
  ["Ember", "--ember", "#EE9A17"],
  ["Ember hover", "--ember-2", "#F1AC41"],
  ["Background", "--bg", "#0B0C0E"],
  ["Card", "--card", "#0F1114"],
  ["Raised", "--bg-2", "#111316"],
  ["Ink", "--ink", "#EEF0F2"],
];

const geometry = [
  ["Border radius — buttons / inputs", "4px", "All .btn; form fields"],
  ["Border radius — tags / chips", "3px", "Mono tags, pill toggles, badges"],
  ["Border radius — cards / panels", "6px", "Surfaces, pricing, metrics, forms"],
  ["Border radius — CTA panel", "8px", "Home CTA banner"],
  ["Border weight", "1px", "Hairline borders & dividers throughout"],
  ["Section padding", "70–96px vertical", "Top-level sections"],
  ["Container width", "1220px", ".wrap max-width"],
];
---

<BaseLayout
  title="Style Guide"
  description="The Studio Harmon design system — colors, type, components, and the rules that hold them together."
>
  <div class="wrap sg">
    <!-- HERO -->
    <section class="sg-hero">
      <span class="eyebrow">Design system</span>
      <h1 class="disp" style="margin-top:14px">
        The <span class="mark-clay">Studio</span> system.
      </h1>
      <p class="sg-lede">
        The complete visual language for Studio Harmon — colors, type,
        components, and the rules that hold them together. Build every new page
        and feature from what's documented here so the product stays one coherent
        thing.
      </p>
    </section>

    <!-- 01 TOKENS -->
    <section class="block">
      <div class="sec-label">
        <span class="num">01</span><h2>Design tokens</h2>
        <span class="desc"
          >Every value lives in a CSS variable on <code>:root</code>. Reference
          the token, never the raw hex.</span
        >
      </div>
      <div class="card" style="padding:8px 22px">
        <table class="tok">
          <tr><th>Token</th><th>Value</th><th>Role</th></tr>
          {
            tokens.map(([name, value, role]) => (
              <tr>
                <td>
                  {value.startsWith("#") && (
                    <span class="dot" style={`background:${value}`} />
                  )}
                  <code>{name}</code>
                </td>
                <td>{value}</td>
                <td>{role}</td>
              </tr>
            ))
          }
        </table>
      </div>
    </section>

    <!-- 02 COLOR -->
    <section class="block">
      <div class="sec-label">
        <span class="num">02</span><h2>Color</h2>
        <span class="desc"
          >Near-black industrial surface, cool steel-grey text, one locked ember
          accent. No second accent hue.</span
        >
      </div>
      <div class="swatches">
        {
          swatches.map(([nm, token, hex]) => (
            <div class="sw">
              <div class="chip" style={`background:${hex}`} />
              <div class="meta">
                <div class="nm">{nm}</div>
                <div class="vals">
                  <code>{token}</code>
                  <span>{hex}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 03 TYPE -->
    <section class="block">
      <div class="sec-label">
        <span class="num">03</span><h2>Typography</h2>
        <span class="desc"
          >Two families. Archivo for display + body, IBM Plex Mono for the label
          voice.</span
        >
      </div>
      <div class="specimen">
        <div class="fam bric">
          <div class="big">Ag</div>
          <div class="name">Archivo</div>
          <div class="use">Display, body &amp; UI · 400–800</div>
          <div class="glyphs">ABCDEFGabcdefg 0123456789</div>
        </div>
        <div class="fam hank">
          <div class="big">Ag</div>
          <div class="name">IBM Plex Mono</div>
          <div class="use">Eyebrows, tags &amp; labels · 400–600</div>
          <div class="glyphs">ABCDEFGabcdefg 0123456789</div>
        </div>
      </div>
      <div class="card">
        <div class="type-row">
          <div class="lbl"><b>Display</b>clamp(54–118px) · 800</div>
          <div class="disp" style="font-size:clamp(34px,5vw,58px)">
            Websites as <span style="color:var(--clay)">ambitious</span> as you.
          </div>
        </div>
        <div class="type-row">
          <div class="lbl"><b>Section H2</b>clamp(34–64px) · 800</div>
          <div class="disp" style="font-size:clamp(26px,3.4vw,40px)">
            Simple, honest pricing.
          </div>
        </div>
        <div class="type-row">
          <div class="lbl"><b>Eyebrow</b>12px · 500 · .14em · caps · mono</div>
          <div><span class="eyebrow">Start a project</span></div>
        </div>
        <div class="type-row">
          <div class="lbl"><b>Body</b>17px · 1.6 · Archivo</div>
          <div style="color:var(--ink-2);max-width:48ch">
            We design and build a complete, live website — then show you the real
            thing before you owe a cent.
          </div>
        </div>
        <div class="type-row">
          <div class="lbl"><b>Accent highlight</b><code>em</code> / <code>.mark-clay</code></div>
          <div style="font-family:'Archivo';font-weight:800;font-size:26px">
            Let's <em style="font-style:normal;color:var(--ember)">build</em> it.
          </div>
        </div>
      </div>
    </section>

    <!-- 04 BUTTONS -->
    <section class="block">
      <div class="sec-label">
        <span class="num">04</span><h2>Buttons</h2>
        <span class="desc"
          >Three variants. Arrow nudges right on hover; solid buttons lift 1px.</span
        >
      </div>
      <div class="demo-row">
        <span class="rl">Variants</span>
        <div class="items">
          <a class="btn btn-clay">Get started <span class="arr">→</span></a>
          <a class="btn btn-ink">Start a project <span class="arr">→</span></a>
          <a class="btn btn-ghost">How it works</a>
        </div>
        <div class="items" style="font-size:14px;color:var(--ink-3);gap:30px">
          <span><code>.btn-clay</code> — primary action</span>
          <span><code>.btn-ink</code> — secondary / dark</span>
          <span><code>.btn-ghost</code> — tertiary / outline</span>
        </div>
      </div>
    </section>

    <!-- 05 FORMS -->
    <section class="block">
      <div class="sec-label">
        <span class="num">05</span><h2>Form controls</h2>
        <span class="desc"
          >Inputs sit on a raised surface with an ember focus ring. Multi-select
          uses mono tag toggles, not checkboxes.</span
        >
      </div>
      <div class="card" style="display:flex;gap:40px;flex-wrap:wrap">
        <div class="field" style="flex:1;min-width:240px;margin-bottom:0">
          <label for="d-name">Your name</label>
          <input id="d-name" type="text" placeholder="Jordan Avery" />
          <label for="d-about" style="margin-top:20px">Tell us about it</label>
          <textarea id="d-about" rows="3" placeholder="What does your business do?"></textarea>
        </div>
        <div class="field" style="flex:1;min-width:240px;margin-bottom:0">
          <label>Pill toggles</label>
          <div class="checks">
            <label class="check"><input type="checkbox" checked /><span>New website</span></label>
            <label class="check"><input type="checkbox" /><span>Redesign</span></label>
            <label class="check"><input type="checkbox" /><span>SEO + GEO</span></label>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 CARDS -->
    <section class="block">
      <div class="sec-label">
        <span class="num">06</span><h2>Surfaces &amp; cards</h2>
        <span class="desc"
          >6px radius, 1px line border, <code>--card</code> fill. The featured
          card gets a 3px ember top bar.</span
        >
      </div>
      <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:flex-start">
        <div class="pc" style="max-width:330px">
          <span class="kicker">The build</span>
          <div class="price-big">$1,200</div>
          <div class="per">once, at launch</div>
          <h3>Your whole website</h3>
          <p>Design, build, copywriting, and launch — however many pages it takes.</p>
        </div>
        <div class="pc feature" style="max-width:330px">
          <span class="kicker">Most popular</span>
          <div class="price-big">$80<span style="font-size:20px">/mo</span></div>
          <div class="per">ongoing membership</div>
          <h3>Ongoing</h3>
          <p>Your website, always growing. Unlimited SEO + GEO, content, and changes.</p>
        </div>
        <div class="metric" style="max-width:280px">
          <b>5–7 days</b><span>to your first live preview</span>
        </div>
      </div>
    </section>

    <!-- 07 PRINCIPLES -->
    <section class="block">
      <div class="sec-label">
        <span class="num">07</span><h2>Principles</h2>
        <span class="desc">The rules that keep new work on-system.</span>
      </div>
      <div class="principles">
        <div class="pr do"><div class="tag">Do</div><h4>One ember accent</h4><p>Ember is the only accent. Use it for primary actions, highlighted words, square markers, and key numbers — sparingly, so it stays loud.</p></div>
        <div class="pr dont"><div class="tag">Don't</div><h4>No new hues or gradients</h4><p>Don't introduce a second accent color or decorative gradients beyond the hero and CTA glow. The look comes from the bg/ink/ember trio alone.</p></div>
        <div class="pr do"><div class="tag">Do</div><h4>Friendly, plain-spoken voice</h4><p>Short, confident, human. Contractions welcome. Lead with the customer's benefit, not jargon.</p></div>
        <div class="pr dont"><div class="tag">Don't</div><h4>No filler or false urgency</h4><p>No countdown timers, no fake scarcity, no padding sections to fill space. Every element earns its place.</p></div>
        <div class="pr do"><div class="tag">Do</div><h4>Generous whitespace</h4><p>Big type, calm spacing, hairline borders. Sections breathe with ~54–96px vertical padding.</p></div>
        <div class="pr do"><div class="tag">Do</div><h4>Restrained motion</h4><p>Subtle, fast transitions only — 1px lifts, a 3px arrow nudge, 0.18–0.22s easing. No looping or flashy animation.</p></div>
      </div>
    </section>

    <!-- 08 GEOMETRY -->
    <section class="block">
      <div class="sec-label">
        <span class="num">08</span><h2>Geometry &amp; spacing</h2>
        <span class="desc">Consistent radii and borders are most of the look.</span>
      </div>
      <div class="card" style="padding:8px 22px">
        <table class="tok">
          <tr><th>Property</th><th>Value</th><th>Applied to</th></tr>
          {
            geometry.map(([prop, value, applied]) => (
              <tr>
                <td>{prop}</td>
                <td>{value}</td>
                <td>{applied}</td>
              </tr>
            ))
          }
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sg code {
    font-family: "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.86em;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 2px 6px;
    color: var(--clay-2);
  }
  .sg-hero {
    padding: 60px 0 30px;
  }
  .sg-hero h1 {
    font-size: clamp(46px, 7vw, 92px);
    font-weight: 800;
  }
  .sg-lede {
    font-size: 19px;
    color: var(--ink-2);
    margin-top: 22px;
    max-width: 54ch;
  }
  .block {
    padding: 54px 0;
    border-top: 1.5px solid var(--line);
  }
  .sec-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 34px;
  }
  .sec-label .num {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: 14px;
    color: var(--ember);
  }
  .sec-label h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 800;
  }
  .sec-label .desc {
    font-size: 15px;
    color: var(--ink-3);
    margin-left: auto;
    max-width: 34ch;
    text-align: right;
  }
  @media (max-width: 760px) {
    .sec-label {
      flex-wrap: wrap;
    }
    .sec-label .desc {
      text-align: left;
      margin-left: 0;
    }
  }
  .card {
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 30px;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }
  .sw {
    border: 1.5px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--white);
  }
  .sw .chip {
    height: 96px;
  }
  .sw .meta {
    padding: 13px 15px;
  }
  .sw .nm {
    font-weight: 700;
    font-size: 14.5px;
  }
  .sw .vals {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 5px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .sw .vals code {
    font-size: 11.5px;
    padding: 1px 5px;
  }
  .type-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1.5px solid var(--line);
  }
  .type-row:last-child {
    border-bottom: none;
  }
  .type-row .lbl {
    font-size: 13px;
    color: var(--ink-3);
  }
  .type-row .lbl b {
    display: block;
    color: var(--ink);
    font-size: 14px;
    margin-bottom: 3px;
  }
  @media (max-width: 680px) {
    .type-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
  .specimen {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }
  .specimen .fam {
    flex: 1;
    min-width: 240px;
  }
  .specimen .big {
    font-size: 54px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .specimen .fam.bric .big {
    font-family: "Archivo", system-ui, sans-serif;
    font-weight: 800;
  }
  .specimen .fam.hank .big {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
  }
  .specimen .fam .name {
    margin-top: 14px;
    font-weight: 700;
  }
  .specimen .fam .use {
    font-size: 14px;
    color: var(--ink-3);
    margin-top: 3px;
  }
  .specimen .fam .glyphs {
    font-size: 15px;
    color: var(--ink-2);
    margin-top: 10px;
    letter-spacing: 0.02em;
  }
  .demo-row {
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .demo-row .rl {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .demo-row .items {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (max-width: 680px) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
  .pr {
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 24px 26px;
  }
  .pr h4 {
    font-size: 18px;
    font-weight: 700;
  }
  .pr p {
    font-size: 14.5px;
    color: var(--ink-2);
    margin-top: 8px;
  }
  .pr.do {
    border-left: 4px solid var(--clay);
  }
  .pr.dont {
    border-left: 4px solid var(--ink-3);
  }
  .pr .tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay-2);
    margin-bottom: 8px;
  }
  .pr.dont .tag {
    color: var(--ink-3);
  }
  .tok {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .tok td,
  .tok th {
    text-align: left;
    padding: 11px 14px;
    border-bottom: 1.5px solid var(--line);
  }
  .tok tr:last-child td {
    border-bottom: none;
  }
  .tok th {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .tok td:first-child {
    width: 34%;
  }
  .tok .dot {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    vertical-align: -2px;
    margin-right: 9px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
</style>
