---
/**
 * Styleguide — Allied Construction Design System Preview
 *
 * Development-only page (noindex) for reviewing the visual design system.
 * Not included in navigation. Renders the real Allied tokens and component
 * patterns using the same global.css and theme utilities as the live site.
 *
 * Source of truth: src/styles/global.css (CSS) + src/data/design-tokens.json
 * (machine-readable). Sections opt into a colour theme via
 * data-theme="Dark" | "Neutral" (default = light); the .theme-* utilities
 * re-colour per section.
 *
 * Layer 1: Tokens (palette, theme system, typography, buttons, effects)
 * Layer 2: Component patterns (hero, cards, stats, CTA, nav, footer)
 */
import Header from "../components/Header.astro";
import "../styles/global.css";

const wrapper = "mx-auto xl:max-w-[80vw] px-8 sm:px-12 lg:px-16";

const arrowSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="order-last ml-2 h-5 w-5" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>';

const swatches = [
  { name: "Brand teal — logo only", value: "#00a7bd", var: "--color-brand", ink: "#ffffff" },
  { name: "Black — ink & dark bands", value: "#000000", var: "black", ink: "#ffffff" },
  { name: "White — light bands", value: "#ffffff", var: "white", ink: "#000000", border: true },
  { name: "Grey — neutral bands", value: "#f2f2f2", var: "--color-grey", ink: "#000000", border: true },
];

const themes = [
  { label: "Default (light)", attr: undefined, note: "White band, black ink." },
  { label: "Neutral", attr: "Neutral", note: "Grey (#f2f2f2) band, black ink." },
  { label: "Dark", attr: "Dark", note: "Black band, white ink, inverted button." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Styleguide — Allied Construction Design System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />

    <!-- Intro -->
    <section class="theme-wrapper py-20 sm:py-28">
      <div class={wrapper}>
        <p class="mb-3 text-lg theme-pretitle">Styleguide</p>
        <h1 class="theme-h1 theme-title mb-4">Design System</h1>
        <p class="max-w-2xl text-lg theme-text">
          The live Allied Construction design system. This page uses the same
          <code class="bg-neutral-100 px-1.5 py-0.5 font-mono text-sm">global.css</code> and
          <code class="bg-neutral-100 px-1.5 py-0.5 font-mono text-sm">.theme-*</code> utilities as
          every other page. Fonts: Syne (display, uppercase) and Albert Sans (body).
        </p>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- LAYER 1: TOKENS                              -->
    <!-- ============================================ -->

    <!-- PALETTE -->
    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <p class="mb-2 text-lg theme-pretitle">Layer 1 — Tokens</p>
        <h2 class="theme-h2 theme-title mb-4">Colour palette</h2>
        <p class="mb-10 max-w-2xl text-lg theme-text">
          Black, white and grey bands carry the whole site. Teal is reserved for the logo only —
          never for section backgrounds or body text.
        </p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            swatches.map((s) => (
              <div>
                <div
                  class:list={["flex h-24 items-end rounded-lg p-3", s.border && "border border-neutral-200"]}
                  style={`background:${s.value};color:${s.ink}`}
                >
                  <span class="text-xs font-medium">{s.value}</span>
                </div>
                <p class="mt-2 text-sm theme-text">{s.name}</p>
              </div>
            ))
          }
        </div>

        <h3 class="theme-h4 theme-title mb-4 mt-14">Neutral scale</h3>
        <p class="mb-6 max-w-2xl text-lg theme-text">
          Supporting greys for borders, dividers, muted text and code — not section bands.
        </p>
        <div class="grid grid-cols-5 gap-2 sm:grid-cols-11">
          {
            [
              { n: "50", c: "h-14 rounded border border-neutral-200 bg-neutral-50" },
              { n: "100", c: "h-14 rounded bg-neutral-100" },
              { n: "200", c: "h-14 rounded bg-neutral-200" },
              { n: "300", c: "h-14 rounded bg-neutral-300" },
              { n: "400", c: "h-14 rounded bg-neutral-400" },
              { n: "500", c: "h-14 rounded bg-neutral-500" },
              { n: "600", c: "h-14 rounded bg-neutral-600" },
              { n: "700", c: "h-14 rounded bg-neutral-700" },
              { n: "800", c: "h-14 rounded bg-neutral-800" },
              { n: "900", c: "h-14 rounded bg-neutral-900" },
              { n: "950", c: "h-14 rounded bg-neutral-950" },
            ].map((s) => (
              <div>
                <div class={s.c} />
                <p class="mt-2 text-xs text-neutral-500">{s.n}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- THEME SYSTEM -->
    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <h2 class="theme-h2 theme-title mb-4">Section theme system</h2>
        <p class="mb-10 max-w-2xl text-lg theme-text">
          Every banded <code class="bg-neutral-100 px-1.5 py-0.5 font-mono text-sm">&lt;section&gt;</code>
          sets <code class="bg-neutral-100 px-1.5 py-0.5 font-mono text-sm">data-theme</code>. The
          same markup re-colours per theme via CSS variables.
        </p>
      </div>
      <div class="space-y-0">
        {
          themes.map((t) => (
            <div data-theme={t.attr} class="theme-wrapper border-t border-neutral-200/40">
              <div class:list={[wrapper, "py-12"]}>
                <p class="mb-2 text-lg theme-pretitle">{t.label}</p>
                <h3 class="theme-h3 theme-title mb-3">The way we build</h3>
                <p class="mb-6 max-w-xl text-lg theme-text">{t.note}</p>
                <div class="flex flex-wrap items-center gap-6">
                  <a href="#0" class="btn btn-primary px-8 py-4 text-base">
                    Get in touch<Fragment set:html={arrowSvg} />
                  </a>
                  <a href="#0" class="btn btn-simple text-base">
                    Learn more<Fragment set:html={arrowSvg} />
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- TYPOGRAPHY -->
    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <h2 class="theme-h2 theme-title mb-4">Typography</h2>
        <p class="mb-10 max-w-2xl text-lg theme-text">
          Display headings are Syne 700, uppercase, fluid-clamped. Body copy and pretitle labels are
          Albert Sans, normal case.
        </p>
        <div class="space-y-8">
          <div>
            <p class="mb-2 text-xs text-neutral-500">.theme-h1 — Syne 700 / clamp(3.5rem, 5.5vw, 4.5rem)</p>
            <p class="theme-h1 theme-title">Built to last</p>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-500">.theme-h2 — clamp(2.25rem, 4.5vw, 3.5rem)</p>
            <p class="theme-h2 theme-title">A better way to build</p>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-500">.theme-h3 — clamp(1.75rem, 3.5vw, 2.5rem)</p>
            <p class="theme-h3 theme-title">Recent projects</p>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-500">.theme-h4 — clamp(1.25rem, 3vw, 2rem)</p>
            <p class="theme-h4 theme-title">Quality craftsmanship</p>
          </div>
        </div>
        <div class="mt-12 max-w-2xl space-y-6">
          <div>
            <p class="mb-2 text-xs text-neutral-500">.theme-pretitle — Albert Sans, label above titles</p>
            <p class="text-lg theme-pretitle">St. George, Utah</p>
          </div>
          <div>
            <p class="mb-2 text-xs text-neutral-500">Body — Albert Sans 400 / text-lg</p>
            <p class="text-lg theme-text">
              At Allied Construction, every project is a promise to deliver top-quality results on
              time and on budget. Timing and quality are everything in commercial construction.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- BUTTONS -->
    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <h2 class="theme-h2 theme-title mb-4">Buttons</h2>
        <p class="mb-10 max-w-2xl text-lg theme-text">
          <code class="bg-neutral-100 px-1.5 py-0.5 font-mono text-sm">.btn.btn-primary</code> is a
          filled button that inverts per theme (black on light, white on dark).
          <code class="bg-neutral-100 px-1.5 py-0.5 font-mono text-sm">.btn.btn-simple</code> is a
          text link with a trailing arrow.
        </p>
        <div class="grid gap-0 sm:grid-cols-2">
          <div class="theme-wrapper flex flex-wrap items-center gap-6 p-10">
            <a href="#0" class="btn btn-primary px-8 py-4 text-base">Primary<Fragment set:html={arrowSvg} /></a>
            <a href="#0" class="btn btn-simple text-base">Simple<Fragment set:html={arrowSvg} /></a>
          </div>
          <div data-theme="Dark" class="theme-wrapper flex flex-wrap items-center gap-6 p-10">
            <a href="#0" class="btn btn-primary px-8 py-4 text-base">Primary<Fragment set:html={arrowSvg} /></a>
            <a href="#0" class="btn btn-simple text-base">Simple<Fragment set:html={arrowSvg} /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- EFFECTS -->
    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <h2 class="theme-h2 theme-title mb-4">Effects</h2>
        <div class="grid gap-8 sm:grid-cols-3">
          <div>
            <p class="mb-3 text-xs text-neutral-500">Card image — rounded-lg, hover zoom</p>
            <div class="group aspect-[3/2] overflow-hidden rounded-lg bg-neutral-200">
              <div class="h-full w-full bg-neutral-300 transition-transform duration-500 group-hover:scale-110" />
            </div>
          </div>
          <div>
            <p class="mb-3 text-xs text-neutral-500">Nav underline — wipes in from left</p>
            <a href="#0" class="nav-link text-lg font-semibold">Hover me</a>
          </div>
          <div>
            <p class="mb-3 text-xs text-neutral-500">Divider — border-neutral-200</p>
            <hr />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- LAYER 2: COMPONENT PATTERNS                  -->
    <!-- ============================================ -->

    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <p class="mb-2 text-lg theme-pretitle">Layer 2 — Patterns</p>
        <h2 class="theme-h2 theme-title mb-4">Component patterns</h2>
        <p class="max-w-2xl text-lg theme-text">Reusable section patterns used across the site.</p>
      </div>
    </section>

    <!-- PATTERN: hero-centered -->
    <section data-theme="Dark" class="theme-wrapper border-t border-neutral-200 py-24 sm:py-32">
      <div class={wrapper}>
        <p class="mb-4 text-xs opacity-60">PATTERN: hero-centered (homepage)</p>
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-3 text-lg theme-pretitle">Allied Construction</p>
          <h2 class="theme-h1 theme-title mb-6">A better way to build</h2>
          <p class="mx-auto mb-8 max-w-xl text-lg theme-text">
            Commercial construction delivered with precision, collaboration, and a commitment to
            excellence.
          </p>
          <a href="#0" class="btn btn-primary px-8 py-4 text-base">Get in touch<Fragment set:html={arrowSvg} /></a>
        </div>
      </div>
    </section>

    <!-- PATTERN: hero-left -->
    <section class="theme-wrapper border-t border-neutral-200 py-24 sm:py-32">
      <div class={wrapper}>
        <p class="mb-4 text-xs text-neutral-500">PATTERN: hero-left (inner pages)</p>
        <div class="max-w-3xl">
          <p class="mb-3 text-lg theme-pretitle">Our services</p>
          <h2 class="theme-h1 theme-title mb-4">Built on experience</h2>
          <p class="text-lg theme-text">Left-aligned hero used on every inner page.</p>
        </div>
      </div>
    </section>

    <!-- PATTERN: card-grid -->
    <section class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <p class="mb-4 text-xs text-neutral-500">PATTERN: card-grid (projects)</p>
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            [1, 2, 3].map((i) => (
              <a href="#0" class="group block">
                <div class="mb-4 aspect-square w-full overflow-hidden rounded-lg bg-neutral-200 sm:aspect-[2/3]">
                  <div class="h-full w-full bg-neutral-300 transition-transform duration-500 group-hover:scale-110" />
                </div>
                <p class="mb-3 text-lg theme-pretitle">St. George, UT — 2024</p>
                <h4 class="theme-h4 theme-title mb-4 underline-offset-8 group-hover:underline">Project {i}</h4>
                <p class="text-lg theme-text">Short project description.</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PATTERN: stats-row -->
    <section data-theme="Neutral" class="theme-wrapper border-t border-neutral-200 py-16 sm:py-20">
      <div class={wrapper}>
        <p class="mb-8 text-xs opacity-60">PATTERN: stats-row</p>
        <dl class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3">
          {
            [
              { l: "Completed", v: "2024" },
              { l: "Project Cost", v: "$41.8M" },
              { l: "Square Feet", v: "160,000" },
            ].map((s) => (
              <div>
                <dt class="mb-2 text-sm theme-pretitle">{s.l}</dt>
                <dd class="theme-h4 theme-title">{s.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- PATTERN: cta-band -->
    <section data-theme="Dark" class="theme-wrapper border-t border-neutral-200 py-24 sm:py-32">
      <div class={wrapper}>
        <p class="mb-4 text-xs opacity-60">PATTERN: cta-band</p>
        <div class="max-w-3xl">
          <h2 class="theme-h2 theme-title mb-4">Let's build something great</h2>
          <p class="mb-8 text-lg theme-text">Partner with Allied Construction for your next project.</p>
          <a href="#0" class="btn btn-primary px-8 py-4 text-base">Contact us today<Fragment set:html={arrowSvg} /></a>
        </div>
      </div>
    </section>
  </body>
</html>
