---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = (await getEntry("pages", "about"))!;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="text-sm uppercase tracking-wide text-neutral-500">
      Tier 1 / 3 — Inline page + Markdown entry
    </p>
    <h1 class="mt-4">{page.data.headline}</h1>
    {page.data.subheadline && (
      <p class="mt-6 max-w-2xl text-lg text-neutral-500">
        {page.data.subheadline}
      </p>
    )}
  </section>

  <!-- File map -->
  <section class="border-t border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-lg">How this page is wired</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium">Route file</dt>
          <dd class="mt-1 text-sm text-neutral-500">
            <code class="rounded bg-white px-1.5 py-0.5">src/pages/about.astro</code> — calls
            <code class="rounded bg-white px-1.5 py-0.5">getEntry("pages", "about")</code> and renders the body.
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium">Content file</dt>
          <dd class="mt-1 text-sm text-neutral-500">
            <code class="rounded bg-white px-1.5 py-0.5">src/content/pages/about.md</code> — the Markdown body and frontmatter you're reading.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Markdown body -->
  <section class="border-t border-neutral-200">
    <div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
