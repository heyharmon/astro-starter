---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Placeholder from "../components/Placeholder.astro";
import FounderNote from "../components/FounderNote.astro";
import ValueGrid from "../components/ValueGrid.astro";
import TeamGrid from "../components/TeamGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import siteContent from "../data/site-content.json";

const page = siteContent.pages.about;
const { founder } = siteContent;
const { story, values, team, cta } = page;
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero eyebrow={page.eyebrow} headline={page.headline} lead={page.lead} />

  <!-- Story -->
  <section class="section story-sec">
    <div class="wrap story-grid">
      <div>
        <h2 class="story-h">{story.heading}</h2>
        {story.paragraphs.map((p) => <p class="story-p">{p}</p>)}
      </div>
      <div class="story-art">
        <Placeholder
          label={story.image.label}
          ratio={story.image.ratio}
          variant={story.image.variant}
        />
      </div>
    </div>
  </section>

  <!-- Founder (no link — we're already on the story page) -->
  <FounderNote
    eyebrow={founder.eyebrow}
    heading={founder.heading}
    name={founder.name}
    title={founder.title}
    image={founder.image}
    quote={founder.quote}
    body={founder.body}
    stat={founder.stat}
  />

  <ValueGrid eyebrow={values.eyebrow} heading={values.heading} items={values.items} />

  <TeamGrid eyebrow={team.eyebrow} heading={team.heading} members={team.members} />

  <CtaBand heading={cta.heading} body={cta.body} button={cta.button} />
</BaseLayout>

<style>
  section.story-sec {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .story-h {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .story-p {
    color: var(--color-ink-soft);
  }
  .story-p + .story-p {
    margin-top: 1rem;
  }
  @media (max-width: 820px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-art {
      order: -1;
    }
  }
</style>
