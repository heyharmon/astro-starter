---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.jsx";
import siteMeta from "../data/site-meta.json";

const wrapper = "mx-auto xl:max-w-[80vw] px-8 sm:px-12 lg:px-16";

const details = [
  {
    label: "Office",
    lines: ["664 E Alabaster Rd Suite B,", "St. George, Utah 84790"],
    href: "https://maps.google.com/?q=664+E+Alabaster+Rd+Suite+B+St.+George+Utah+84790",
  },
  { label: "Email", lines: ["info@builtbyallied.com"], href: "mailto:info@builtbyallied.com" },
  { label: "Phone", lines: ["(727) 612-0213"], href: "tel:+17276120213" },
];
---

<BaseLayout
  title="Contact"
  description="Contact Allied Construction or visit our St. George, Utah office to start your project. Let's bring your vision to life!"
>
  <!-- Hero -->
  <PageHero
    theme="Dark"
    title="Get in touch"
    body="Ready to bring your vision to life? Or just have questions about how we can support your project? Contact Allied Construction today. Your exceptional experience starts here."
    paddingClass="py-24 sm:py-28 lg:py-36"
  />

  <!-- Contact details -->
  <section data-theme="Neutral" class="theme-wrapper relative z-10 py-20 sm:py-28">
    <div class={wrapper}>
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
        {
          details.map((d) => (
            <div>
              <h3 class="theme-h4 theme-title mb-4">{d.label}</h3>
              <a href={d.href} class="text-lg theme-text transition-opacity hover:opacity-70">
                {d.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Message form -->
  <section class="theme-wrapper relative z-10 py-20 sm:py-28 lg:py-32">
    <div class={wrapper}>
      <div class="max-w-2xl">
        <div class="mb-10">
          <h3 class="theme-h3 theme-title mb-4">Send a message</h3>
          <p class="text-lg theme-text">
            Have questions or ready to start your next project? Reach out to our team and let's
            build something together.
          </p>
        </div>
        <ContactForm client:idle basinFormId={siteMeta.basinFormId} />
      </div>
    </div>
  </section>
</BaseLayout>
