---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Placeholder from "../components/Placeholder.astro";
import ContactForm from "../components/ContactForm.jsx";
import siteMeta from "../data/site-meta.json";
import siteContent from "../data/site-content.json";

const page = siteContent.pages.contact;
const { contact } = siteContent;
const form = page.form;
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero eyebrow={page.eyebrow} headline={page.headline} lead={page.lead} />

  <section class="section contact-sec" id="tour">
    <div class="wrap contact-grid">
      <ContactForm
        client:idle
        formspreeId={siteMeta.formspreeId}
        title={form.title}
        submitLabel={form.submitLabel}
        note={form.note}
        successMessage={form.successMessage}
        ageOptions={form.ageOptions}
        startOptions={form.startOptions}
      />

      <div class="contact-info">
        {
          page.info.map((block) => (
            <div class="info-block">
              <h3>{block.label}</h3>
              <p set:html={block.lines.join("<br>")} />
            </div>
          ))
        }
        <div class="info-block">
          <h3>Talk to us</h3>
          <p>
            <a href={contact.phoneHref}>{contact.phone}</a><br />
            <a href={contact.emailHref}>{contact.email}</a>
          </p>
        </div>
        <Placeholder label={page.map.label} ratio={page.map.ratio} class="map-ph" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section.contact-sec {
    padding-top: clamp(1rem, 2vw, 2rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .info-block {
    margin-bottom: 2rem;
  }
  .info-block h3 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }
  .info-block p {
    font-size: 1.05rem;
  }
  .info-block a {
    color: var(--color-primary-d);
    font-weight: 600;
  }
  .contact-info :global(.map-ph) {
    margin-top: 1rem;
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
