---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.jsx";
import siteMeta from "../data/site-meta.json";

const c = siteMeta.contact;
const description =
  "Get in touch with Eagle Point Welding in St. George, Utah. Request a quote for structural, residential, certified rig, or pipe welding.";
---

<BaseLayout title="Contact" description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="flex min-h-[45vh] flex-col items-center justify-center bg-black px-6 pt-28 pb-12 text-center">
    <h1 class="text-[3.5rem] leading-[1.02] sm:text-[5rem] lg:text-[5.5rem]">Contact us</h1>
    <p class="mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-ink">
      Tell us about your project. Certified, experienced, and always on time — we'll get back to you
      fast.
    </p>
  </section>

  <!-- ===================== INFO + FORM ===================== -->
  <section class="bg-surface py-20 lg:py-28">
    <div class="epw-container grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <!-- Contact info -->
      <div>
        <span class="mb-6 block h-[2px] w-12 bg-white/50"></span>
        <h2>Contact info</h2>

        <dl class="mt-8 space-y-7">
          <div class="flex items-start gap-4">
            <svg class="mt-1 h-5 w-5 flex-none text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="1"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <div>
              <dt class="text-[13px] uppercase tracking-[0.5px] text-ink-dim">Email</dt>
              <dd class="mt-1">
                <a href={`mailto:${c.email}`} class="text-[16px] text-white transition-colors hover:text-ink">{c.email}</a>
              </dd>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="mt-1 h-5 w-5 flex-none text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path>
            </svg>
            <div>
              <dt class="text-[13px] uppercase tracking-[0.5px] text-ink-dim">Phone</dt>
              <dd class="mt-1">
                <a href={c.phoneHref} class="text-[16px] text-white transition-colors hover:text-ink">{c.phone}</a>
              </dd>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="mt-1 h-5 w-5 flex-none text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <div>
              <dt class="text-[13px] uppercase tracking-[0.5px] text-ink-dim">Location</dt>
              <dd class="mt-1 text-[16px] text-white">{c.location}</dd>
            </div>
          </div>
        </dl>

        <p class="mt-9 max-w-xs text-[15px] leading-relaxed text-ink">{c.serviceArea}</p>
      </div>

      <!-- Form -->
      <div>
        <span class="mb-6 block h-[2px] w-12 bg-white/50"></span>
        <h2>Send a message</h2>
        <div class="mt-8">
          <ContactForm client:idle formspreeId={siteMeta.formspreeId} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
