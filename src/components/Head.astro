---
import siteMeta from "../data/site-meta.json";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
}

const { title, description, image, canonicalURL } = Astro.props;
const pageTitle = title === "Home" ? siteMeta.name : `${title} | ${siteMeta.name}`;
const metaDescription = description || siteMeta.description || siteMeta.tagline;
const canonical = canonicalURL || new URL(Astro.url.pathname, siteMeta.url).href;

// Resolve any path to an absolute URL. Social crawlers and structured data
// require absolute og:image / image URLs, not site-relative paths.
const toAbsolute = (path) =>
  !path ? "" : path.startsWith("http") ? path : new URL(path, siteMeta.url).href;
const ogImage = toAbsolute(image || siteMeta.ogImage || "");

// LocalBusiness structured data — helps Google understand the business entity,
// service area, and contact details for local search and the knowledge panel.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: siteMeta.name,
  description: siteMeta.description,
  url: siteMeta.url,
  ...(siteMeta.contact?.phone ? { telephone: siteMeta.contact.phone } : {}),
  ...(siteMeta.contact?.email ? { email: siteMeta.contact.email } : {}),
  image: toAbsolute(siteMeta.ogImage),
  logo: toAbsolute("/images/eaglepoint/logo-white.svg"),
  address: {
    "@type": "PostalAddress",
    addressLocality: "St. George",
    addressRegion: "UT",
    addressCountry: "US",
  },
  ...(siteMeta.contact?.serviceArea ? { areaServed: siteMeta.contact.serviceArea } : {}),
  ...(siteMeta.social ? { sameAs: Object.values(siteMeta.social) } : {}),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts: Bebas Neue (display) + Work Sans (body) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Work+Sans:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
{ogImage && <meta property="og:image" content={ogImage} />}

<!-- Twitter -->
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- Structured data: LocalBusiness -->
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
