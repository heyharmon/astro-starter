---
/**
 * Faq — accessible accordion built on native <details>/<summary>
 * (works without JS). The +/- icon flips to − when open.
 */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((f) => (
    <details class="faq-item">
      <summary>
        <span>{f.q}</span>
        <span class="faq-icon" aria-hidden="true"></span>
      </summary>
      <div class="faq-a"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-line);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    background: var(--color-accent);
    transition: transform 0.2s ease;
  }
  .faq-icon::before {
    left: 0;
    top: 7px;
    width: 16px;
    height: 2px;
  }
  .faq-icon::after {
    left: 7px;
    top: 0;
    width: 2px;
    height: 16px;
  }
  .faq-item[open] .faq-icon::after {
    transform: scaleY(0);
  }
  .faq-a {
    padding: 0 0 1.4rem;
    color: var(--color-ink-soft);
    max-width: 70ch;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-icon::before,
    .faq-icon::after {
      transition: none;
    }
  }
</style>
