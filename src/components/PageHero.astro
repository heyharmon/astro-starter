---
/**
 * PageHero — the simple hero used on Programs / About / Contact:
 * eyebrow + headline (with accent word) + lead.
 */
interface Props {
  eyebrow: string;
  headline: { before: string; accent: string; after: string };
  lead: string;
}
const { eyebrow, headline, lead } = Astro.props;
---

<section class="wrap page-hero">
  <div class="page-hero-head">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{headline.before}<em class="accent">{headline.accent}</em>{headline.after}</h1>
  </div>
  <p class="lead">{lead}</p>
</section>

<style>
  .page-hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: end;
    column-gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }
  .page-hero h1 {
    font-size: var(--step-4);
    margin-top: 1.1rem;
    max-width: 16ch;
  }
  .page-hero .lead {
    max-width: 42ch;
    padding-bottom: 0.4rem;
  }
  @media (max-width: 820px) {
    .page-hero {
      grid-template-columns: 1fr;
      row-gap: 1.4rem;
      align-items: start;
    }
    .page-hero h1 { max-width: 18ch; }
    .page-hero .lead { max-width: 54ch; }
  }
</style>
