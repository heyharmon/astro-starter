---
import siteMeta from "../data/site-meta.json";

const socialLinks = Object.entries(siteMeta.social).filter(([, url]) => url);
---

<footer class="bg-black pt-16 pb-10 text-center">
  <div class="epw-container">
    <a href="/" class="inline-block" aria-label={siteMeta.name}>
      <img
        src="/images/eaglepoint/logo-white.svg"
        alt={siteMeta.name}
        class="mx-auto h-10 w-auto"
        width="354"
        height="40"
      />
    </a>

    {
      siteMeta.tagline && (
        <p class="mt-6 text-[15px] tracking-wide text-ink">{siteMeta.tagline}</p>
      )
    }

    {
      socialLinks.length > 0 && (
        <div class="mt-7 flex items-center justify-center gap-4">
          {socialLinks.map(([platform, url]) => (
            <a
              href={url as string}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={platform}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:border-white hover:bg-white hover:text-black"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
              </svg>
            </a>
          ))}
        </div>
      )
    }

    <p class="mt-10 text-xs text-ink-dim">{siteMeta.copyright}</p>
  </div>
</footer>
