---
import footer from "../data/footer.json";
import siteMeta from "../data/site-meta.json";
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="brand">
          <svg class="mark" viewBox="0 0 30 30" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="28" height="28" rx="7" fill="#C05A2E"></rect>
            <path
              d="M8 21V10l7 7 7-7v11"
              stroke="#FBF8F2"
              stroke-width="2.1"
              stroke-linejoin="round"
              stroke-linecap="round"></path>
          </svg>
          {siteMeta.name}
        </a>
        {siteMeta.footerBlurb && <p>{siteMeta.footerBlurb}</p>}
      </div>

      <div class="foot-cols">
        {
          footer.map((col) => (
            <div class="foot-col">
              <h5>{col.section}</h5>
              {col.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="foot-bottom">
      <span>{siteMeta.copyright}</span>
      <span>{(siteMeta.legal ?? []).join(" · ")}</span>
    </div>
  </div>
</footer>
