---
import footer from "../data/footer.json";
import siteMeta from "../data/site-meta.json";
import siteContent from "../data/site-content.json";

const meta = siteMeta as {
  name: string;
  shortName?: string;
  footerBlurb?: string;
  copyright?: string;
  licenseNote?: string;
};
const brand = meta.shortName ?? meta.name;
const { contact } = siteContent;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="brand"><span class="mark"></span>{brand}</a>
        {meta.footerBlurb && <p>{meta.footerBlurb}</p>}
      </div>

      {
        footer.map((col) => (
          <div>
            <h4>{col.section}</h4>
            <ul>
              {col.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h4>Visit</h4>
        <ul>
          <li>{contact.address.join(", ")}</li>
          <li>{contact.hours.join(" · ")}</li>
          <li><a href={contact.phoneHref}>{contact.phone}</a></li>
          <li><a href={contact.emailHref}>{contact.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      {meta.copyright && <span>{meta.copyright}</span>}
      {meta.licenseNote && <span>{meta.licenseNote}</span>}
    </div>
  </div>
</footer>

<style>
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 2rem;
  }
  .foot-grid h4 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, #fff 60%, transparent);
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .foot-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .foot-brand .brand {
    color: #fff;
    margin-bottom: 1rem;
  }
  .foot-brand p {
    font-size: 0.92rem;
    color: color-mix(in srgb, #fff 72%, transparent);
    max-width: 30ch;
  }
  .foot-bottom {
    border-top: 1px solid color-mix(in srgb, #fff 16%, transparent);
    margin-top: 3rem;
    padding-top: 1.6rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.84rem;
    color: color-mix(in srgb, #fff 68%, transparent);
    flex-wrap: wrap;
  }
  @media (max-width: 820px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .foot-grid { grid-template-columns: 1fr; }
  }
</style>
