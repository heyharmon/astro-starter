---
/**
 * Testimonials — 3 quote cards on a dark (primary-d) band.
 */
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  heading: string;
  rating?: { stars: string; text: string };
  items: { quote: string; name: string; detail: string }[];
}
const { eyebrow, heading, rating, items } = Astro.props;
---

<section class="section quotes">
  <div class="wrap">
    <div class="q-head">
      <div>
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 class="quotes-h">{heading}</h2>
      </div>
      {rating && (
        <p class="q-rating"><span class="q-stars">{rating.stars}</span> {rating.text}</p>
      )}
    </div>
    <div class="q-grid" data-stagger>
      {items.map((t) => (
        <figure class="q-card">
          <p>{t.quote}</p>
          <figcaption class="who">
            <span class="av"></span>
            <span>
              <b>{t.name}</b>
              <span class="detail">{t.detail}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes {
    background: var(--color-primary-d);
    color: color-mix(in srgb, #fff 92%, var(--color-primary-d));
  }
  .quotes :global(.eyebrow) {
    color: var(--color-accent-2);
  }
  .q-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .quotes-h {
    color: #fff;
    font-size: var(--step-3);
    margin-top: 0.9rem;
    max-width: 18ch;
  }
  .q-rating {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.92rem;
    color: color-mix(in srgb, #fff 78%, transparent);
  }
  .q-stars {
    color: var(--color-accent-2);
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .q-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(2.4rem, 5vw, 3.5rem);
    /* light vertical hairlines between quotes, no card chrome */
    border-top: 1px solid color-mix(in srgb, #fff 16%, transparent);
  }
  .q-card {
    margin: 0;
    padding: clamp(1.6rem, 3vw, 2.2rem) clamp(1.4rem, 3vw, 2rem);
  }
  .q-card + .q-card {
    border-left: 1px solid color-mix(in srgb, #fff 16%, transparent);
  }
  .q-card > p {
    margin: 0 0 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 0.9rem + 0.7vw, 1.35rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: pretty;
  }
  .q-card > p::before {
    content: "\201C";
    color: var(--color-accent-2);
    margin-right: 0.05em;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.88rem;
  }
  .who .av {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent-2) 60%, #fff);
    flex: none;
  }
  .who b {
    display: block;
    color: #fff;
  }
  .who .detail {
    color: color-mix(in srgb, #fff 70%, transparent);
  }
  @media (max-width: 860px) {
    .q-grid {
      grid-template-columns: 1fr;
    }
    .q-card {
      padding-inline: 0;
    }
    .q-card + .q-card {
      border-left: none;
      border-top: 1px solid color-mix(in srgb, #fff 16%, transparent);
    }
  }
</style>
