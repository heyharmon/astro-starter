---
/**
 * ProgramCard — home-page program preview (square image + age +
 * title + blurb). The programs page uses ProgramRow instead.
 * Presentation varies by theme (card vs grid); API is fixed.
 */
import Placeholder from "./Placeholder.astro";

interface Props {
  program: {
    ageShort: string;
    title: string;
    previewBlurb: string;
    image: { label: string };
  };
}
const { program } = Astro.props;
---

<article class="prog-card">
  <div class="prog-frame">
    <Placeholder label={program.image.label} ratio="1/1" />
  </div>
  <span class="age">{program.ageShort}</span>
  <h3>{program.title}</h3>
  <p>{program.previewBlurb}</p>
</article>

<style>
  .prog-card {
    display: flex;
    flex-direction: column;
  }
  .prog-frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    margin-bottom: 1.1rem;
  }
  .prog-frame :global(.ph) {
    border-radius: 0;
    transition: transform 0.5s var(--ease-out);
  }
  .prog-card:hover .prog-frame :global(.ph) {
    transform: scale(1.04);
  }
  .age {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .age::before {
    content: "";
    width: 18px;
    height: 1.5px;
    background: currentColor;
  }
  .prog-card h3 {
    font-size: var(--step-1);
    margin: 0.45rem 0 0.55rem;
  }
  .prog-card p {
    font-size: 0.93rem;
    color: var(--color-ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .prog-frame :global(.ph) { transition: none; }
    .prog-card:hover .prog-frame :global(.ph) { transform: none; }
  }
</style>
