---
/**
 * FeatureGrid — "why families choose us". An asymmetric split: a statement
 * heading + lead-in on the left, the reasons as hairline-divided rows on the
 * right (deliberately NOT a 2x2 card grid). Sits on the sunk panel.
 */
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  heading: string;
  items: { icon: string; title: string; body: string }[];
}
const { eyebrow, heading, items } = Astro.props;

const icons: Record<string, string> = {
  home: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v9h14v-9"/><path d="M10 19v-5h4v5"/></svg>',
  people: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>',
  book: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v18"/><path d="M5 7c3 0 5 1 7 2 2-1 4-2 7-2v11c-3 0-5 1-7 2-2-1-4-2-7-2Z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 8 9 5 9-5"/></svg>',
};
---

<section class="section why">
  <div class="wrap why-grid">
    <div class="why-intro">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="why-h">{heading}</h2>
    </div>
    <ul class="why-list" data-stagger>
      {items.map((it) => (
        <li class="why-item">
          <div class="ico" set:html={icons[it.icon] ?? icons.home} />
          <div>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--color-surface-2);
  }
  .why-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .why-intro {
    position: sticky;
    top: 96px;
  }
  .why-h {
    font-size: var(--step-3);
    margin-top: 1rem;
    max-width: 12ch;
  }
  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .why-item {
    display: flex;
    gap: 1.3rem;
    padding-block: clamp(1.4rem, 3vw, 2rem);
  }
  .why-item + .why-item {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }
  .why-item:first-child { padding-top: 0; }
  .ico {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    display: grid;
    place-content: center;
    color: var(--color-ink);
  }
  .why-item h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .why-item p {
    font-size: 0.96rem;
    color: var(--color-ink-soft);
    max-width: 48ch;
  }
  @media (max-width: 860px) {
    .why-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 2.5rem);
    }
    .why-intro {
      position: static;
    }
    .why-h { max-width: 18ch; }
  }
</style>
