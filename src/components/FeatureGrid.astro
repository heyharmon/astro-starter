---
/**
 * FeatureGrid — "why families choose us": 2x2 icon + title + body
 * cards on a sunk panel. Renders site-content `features`.
 */
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  heading: string;
  items: { icon: string; title: string; body: string }[];
}
const { eyebrow, heading, items } = Astro.props;

const icons: Record<string, string> = {
  home: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v9h14v-9"/><path d="M10 19v-5h4v5"/></svg>',
  people: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>',
  book: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v18"/><path d="M5 7c3 0 5 1 7 2 2-1 4-2 7-2v11c-3 0-5 1-7 2-2-1-4-2-7-2Z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 8 9 5 9-5"/></svg>',
};
---

<section class="section why">
  <div class="wrap">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="why-h">{heading}</h2>
    <div class="why-grid">
      {items.map((it) => (
        <div class="why-item">
          <div class="ico" set:html={icons[it.icon] ?? icons.home} />
          <div>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--color-surface-2);
  }
  .why-h {
    font-size: var(--step-3);
    margin-top: 0.8rem;
    max-width: 18ch;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin-top: 2.6rem;
  }
  .why-item {
    display: flex;
    gap: 1.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .ico {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-primary) 16%, var(--color-surface));
    display: grid;
    place-content: center;
    color: var(--color-primary-d);
  }
  .why-item h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .why-item p {
    font-size: 0.93rem;
    color: var(--color-ink-soft);
  }
  @media (max-width: 720px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
