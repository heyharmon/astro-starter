---
/**
 * StepList — numbered process steps (e.g. how enrollment works).
 * Renders as a responsive row of numbered cards.
 */
interface Props {
  items: { title: string; body: string }[];
}
const { items } = Astro.props;
---

<ol class="steps">
  {items.map((s, i) => (
    <li class="step">
      <span class="step-n">{i + 1}</span>
      <div class="step-c">
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .step-n {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    display: grid;
    place-content: center;
    z-index: 1;
  }
  /* Connector through the step numbers — only in the full 4-up layout */
  @media (min-width: 821px) {
    .step:not(:last-child) .step-n::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 100%;
      width: 1.5rem;
      height: 1.5px;
      background: var(--color-line);
      transform: translateY(-50%);
    }
  }
  .step-c h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .step-c p {
    font-size: 0.93rem;
    color: var(--color-ink-soft);
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
