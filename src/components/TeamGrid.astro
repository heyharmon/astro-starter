---
/**
 * TeamGrid — about page: educator portrait + name + role.
 */
import Eyebrow from "./Eyebrow.astro";
import Placeholder from "./Placeholder.astro";

interface Props {
  eyebrow: string;
  heading: string;
  members: { name: string; role: string; image: { label: string } }[];
}
const { eyebrow, heading, members } = Astro.props;
---

<section class="section team-sec">
  <div class="wrap">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="team-h">{heading}</h2>
    <div class="team-grid" data-stagger>
      {members.map((m) => (
        <div class="member">
          <div class="member-frame">
            <Placeholder label={m.image.label} ratio="1/1" />
          </div>
          <b>{m.name}</b>
          <span>{m.role}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team-h {
    font-size: var(--step-3);
    margin-top: 0.8rem;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
    margin-top: 2.6rem;
  }
  .member-frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    margin-bottom: 0.9rem;
  }
  .member-frame :global(.ph) {
    border-radius: 0;
    transition: transform 0.5s var(--ease-out);
  }
  .member:hover .member-frame :global(.ph) {
    transform: scale(1.04);
  }
  .member b {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .member span {
    display: block;
    color: var(--color-ink-soft);
    font-size: 0.86rem;
    margin-top: 0.15rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .member-frame :global(.ph) { transition: none; }
    .member:hover .member-frame :global(.ph) { transform: none; }
  }
  @media (max-width: 760px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
