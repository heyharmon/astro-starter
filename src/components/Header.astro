---
import Button from "./Button.astro";
import nav from "../data/nav.json";
import siteMeta from "../data/site-meta.json";
import siteContent from "../data/site-content.json";

const pathname = Astro.url.pathname;
const sortedNav = [...nav].sort((a, b) => a.order - b.order);
const brand = (siteMeta as { shortName?: string }).shortName ?? siteMeta.name;
const cta = siteContent.cta.button;

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
---

<header class="site-header">
  <div class="wrap nav">
    <a href="/" class="brand"><span class="mark"></span>{brand}</a>

    <nav class="nav-links" aria-label="Primary">
      {
        sortedNav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-cta">
      <Button href={cta.href} variant="primary" arrow>{cta.label}</Button>
    </div>

    <details class="mobile-nav">
      <summary class="nav-toggle" aria-label="Toggle navigation menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>
      <div class="mobile-menu">
        {
          sortedNav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        <Button href={cta.href} variant="primary" arrow>{cta.label}</Button>
      </div>
    </details>
  </div>
</header>
