---
interface Props {
  pretitle: string;
  title: string;
  body: string;
  images: string[];
}

const { pretitle, title, body, images } = Astro.props;
---

<!-- Preload the first (LCP) hero image so it starts loading immediately
     rather than being discovered late via CSS background-image. -->
{images[0] && <link rel="preload" as="image" href={images[0]} fetchpriority="high" />}

<section
  data-theme="Dark"
  class="theme-wrapper relative isolate overflow-hidden pt-44 pb-44 sm:pt-56 sm:pb-56 sticky top-0 z-0"
>
  <!-- Background crossfade slideshow. Only the first slide sets its
       background inline (LCP); the rest carry data-bg and are assigned
       on idle so they don't compete with the critical render. -->
  <ul id="hero-slideshow" class="absolute inset-0 pointer-events-none">
    {
      images.map((src, i) => (
        <li class="absolute inset-0 overflow-hidden">
          <span
            class="hero-slide absolute inset-0 bg-cover bg-center"
            data-bg={i === 0 ? undefined : src}
            style={i === 0 ? `background-image:url(${src});opacity:1;` : "opacity:0;"}
          />
        </li>
      ))
    }
    <div aria-hidden="true" class="absolute inset-0 h-full w-full bg-black opacity-60"></div>
  </ul>

  <!-- Content -->
  <div class="relative mx-auto xl:max-w-[80vw] px-8 sm:px-12 lg:px-16">
    <div class="m-auto max-w-3xl text-center">
      <p class="mb-3 text-lg theme-pretitle">{pretitle}</p>
      <h1 class="theme-h1 theme-title mb-4">{title}</h1>
      <p class="text-lg theme-text">{body}</p>
    </div>
  </div>
</section>

<style>
  /* Ken Burns: each slide slowly drifts + zooms so there's always
     motion between crossfades (max ~13% zoom). */
  .hero-slide {
    will-change: transform;
    animation: ken-burns-1 18s linear infinite alternate;
  }
  #hero-slideshow li:nth-child(2) .hero-slide {
    animation-name: ken-burns-2;
  }
  #hero-slideshow li:nth-child(3) .hero-slide {
    animation-name: ken-burns-3;
  }

  @keyframes ken-burns-1 {
    from {
      transform: scale(1.02) translate(0, 0);
    }
    to {
      transform: scale(1.13) translate(-3%, -2%);
    }
  }
  @keyframes ken-burns-2 {
    from {
      transform: scale(1.13) translate(3%, 2%);
    }
    to {
      transform: scale(1.02) translate(0, 0);
    }
  }
  @keyframes ken-burns-3 {
    from {
      transform: scale(1.02) translate(2%, -2%);
    }
    to {
      transform: scale(1.13) translate(-2%, 3%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
    }
  }
</style>

<script>
  const slides = Array.from(
    document.querySelectorAll<HTMLElement>("#hero-slideshow .hero-slide"),
  );

  // Assign the deferred slide backgrounds once the page is idle so they
  // load shortly after first paint, off the critical path.
  const loadDeferred = () => {
    slides.forEach((s) => {
      const bg = s.dataset.bg;
      if (bg && !s.style.backgroundImage) s.style.backgroundImage = `url(${bg})`;
    });
  };
  if ("requestIdleCallback" in window) {
    (window as any).requestIdleCallback(loadDeferred, { timeout: 2000 });
  } else {
    setTimeout(loadDeferred, 500);
  }

  if (slides.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    slides.forEach((s) => (s.style.transition = "opacity 2s ease-in-out"));
    let current = 0;
    setInterval(() => {
      slides[current].style.opacity = "0";
      current = (current + 1) % slides.length;
      slides[current].style.opacity = "1";
    }, 5000);
  }
</script>
